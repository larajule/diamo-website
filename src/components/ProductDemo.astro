---
---

<section class="demo section" id="demo">
  <div class="container">
    <div class="demo-header">
      <span class="section-label animate-in" data-i18n="demo.label">See it in action</span>
      <h2 class="animate-in" data-i18n="demo.title">
        Real life changes.<br/>Your movement can too.
      </h2>
      <p class="demo-intro animate-in" data-i18n="demo.intro">
        Explore how diamo could adapt to three everyday situations. This is a preview of the experience we're building.
      </p>
    </div>

    <div class="demo-module animate-in">
      <!-- Tab selector -->
      <div class="demo-tabs" role="tablist">
        <button class="demo-tab active" data-scenario="a" role="tab" aria-selected="true" id="tab-a">
          <span class="demo-tab-icon">⏱</span>
          <span data-i18n="demo.a.tab">Busy day</span>
        </button>
        <button class="demo-tab" data-scenario="b" role="tab" aria-selected="false" id="tab-b">
          <span class="demo-tab-icon">🔋</span>
          <span data-i18n="demo.b.tab">Low energy</span>
        </button>
        <button class="demo-tab" data-scenario="c" role="tab" aria-selected="false" id="tab-c">
          <span class="demo-tab-icon">👥</span>
          <span data-i18n="demo.c.tab">Social day</span>
        </button>
      </div>

      <!-- Scenario panels -->
      <div class="demo-stage">
        <!-- Scenario A -->
        <div class="demo-panel active" data-panel="a" role="tabpanel" aria-labelledby="tab-a">
          <p class="demo-situation" data-i18n="demo.a.situation">You only have 25 minutes instead of 45.</p>
          <div class="demo-comparison">
            <div class="demo-card demo-card--before">
              <span class="demo-card-label" data-i18n="demo.a.before">Original plan</span>
              <span class="demo-card-value" data-i18n="demo.a.before.detail">45 min Full Body Strength</span>
              <div class="demo-card-bar"><div class="demo-bar-fill" style="width: 100%"></div></div>
            </div>
            <div class="demo-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <div class="demo-card demo-card--after">
              <span class="demo-card-label" data-i18n="demo.a.after">Adapted plan</span>
              <span class="demo-card-value" data-i18n="demo.a.after.detail">25 min Express Strength</span>
              <div class="demo-card-bar"><div class="demo-bar-fill demo-bar-fill--adapted" style="width: 56%"></div></div>
            </div>
          </div>
          <p class="demo-reason" data-i18n="demo.a.reason">Keeps your weekly strength target on track with a focused session that fits your schedule.</p>
        </div>

        <!-- Scenario B -->
        <div class="demo-panel" data-panel="b" role="tabpanel" aria-labelledby="tab-b">
          <p class="demo-situation" data-i18n="demo.b.situation">You slept badly and your energy is low.</p>
          <div class="demo-comparison">
            <div class="demo-card demo-card--before">
              <span class="demo-card-label" data-i18n="demo.b.before">Original plan</span>
              <span class="demo-card-value" data-i18n="demo.b.before.detail">HIIT Cardio · 35 min</span>
              <div class="demo-card-bar"><div class="demo-bar-fill" style="width: 85%"></div></div>
            </div>
            <div class="demo-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <div class="demo-card demo-card--after">
              <span class="demo-card-label" data-i18n="demo.b.after">Adapted plan</span>
              <span class="demo-card-value" data-i18n="demo.b.after.detail">Mobility Flow · 20 min</span>
              <div class="demo-card-bar"><div class="demo-bar-fill demo-bar-fill--recovery" style="width: 35%"></div></div>
            </div>
          </div>
          <p class="demo-reason" data-i18n="demo.b.reason">Your body needs recovery, not intensity. A lighter session that still counts as meaningful movement.</p>
        </div>

        <!-- Scenario C -->
        <div class="demo-panel" data-panel="c" role="tabpanel" aria-labelledby="tab-c">
          <p class="demo-situation" data-i18n="demo.c.situation">You'd rather move with others today.</p>
          <div class="demo-comparison">
            <div class="demo-card demo-card--before">
              <span class="demo-card-label" data-i18n="demo.c.before">Original plan</span>
              <span class="demo-card-value" data-i18n="demo.c.before.detail">Solo Endurance Run · 40 min</span>
              <div class="demo-card-bar"><div class="demo-bar-fill" style="width: 75%"></div></div>
            </div>
            <div class="demo-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            <div class="demo-card demo-card--after">
              <span class="demo-card-label" data-i18n="demo.c.after">Community option</span>
              <span class="demo-card-value" data-i18n="demo.c.after.detail">Local Run Club · 18:30</span>
              <div class="demo-card-bar"><div class="demo-bar-fill demo-bar-fill--social" style="width: 75%"></div></div>
            </div>
          </div>
          <p class="demo-reason" data-i18n="demo.c.reason">Same movement goal, better experience. Train with real people near you.</p>
        </div>
      </div>

      <p class="demo-disclaimer" data-i18n="demo.note">Preview · Adaptive features in development</p>
    </div>
  </div>
</section>

<style>
  .demo {
    background: var(--navy-deep);
    color: var(--white);
  }

  .demo .section-label { color: var(--electric); opacity: 0.8; }

  .demo-header {
    max-width: 560px;
    margin-bottom: var(--space-2xl);
  }
  .demo-header h2 { color: var(--white); margin-bottom: var(--space-md); }

  .demo-intro {
    color: var(--text-inverse-muted);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.7;
  }

  /* ─── Module container ─── */
  .demo-module {
    max-width: 720px;
    margin: 0 auto;
  }

  /* ─── Tabs ─── */
  .demo-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: var(--space-lg);
  }

  .demo-tab {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1.5px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    color: var(--text-inverse-muted);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s var(--ease-out);
  }

  .demo-tab:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .demo-tab.active {
    background: rgba(44, 122, 255, 0.12);
    border-color: rgba(44, 122, 255, 0.35);
    color: var(--white);
  }

  .demo-tab-icon { font-size: 1rem; line-height: 1; }

  /* ─── Stage & panels ─── */
  .demo-stage {
    position: relative;
    min-height: 280px;
  }

  .demo-panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .demo-panel.active {
    position: relative;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .demo-situation {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--white);
    margin-bottom: var(--space-md);
    font-style: italic;
    opacity: 0.9;
  }

  /* ─── Comparison cards ─── */
  .demo-comparison {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .demo-card {
    flex: 1;
    padding: var(--space-md);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .demo-card--before {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .demo-card--after {
    background: rgba(44, 122, 255, 0.08);
    border: 1px solid rgba(44, 122, 255, 0.2);
  }

  .demo-card-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-inverse-muted);
  }
  .demo-card--after .demo-card-label {
    color: var(--electric);
  }

  .demo-card-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--white);
  }

  .demo-card-bar {
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 0.25rem;
  }

  .demo-bar-fill {
    height: 100%;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.3);
    transition: width 0.6s var(--ease-out);
  }
  .demo-bar-fill--adapted { background: var(--electric); }
  .demo-bar-fill--recovery { background: var(--mobility); }
  .demo-bar-fill--social { background: var(--endurance); }

  .demo-arrow {
    flex-shrink: 0;
    color: var(--electric);
    opacity: 0.6;
  }

  .demo-reason {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text-inverse-muted);
    max-width: 560px;
    padding-left: var(--space-sm);
    border-left: 2px solid rgba(44, 122, 255, 0.3);
  }

  .demo-disclaimer {
    margin-top: var(--space-lg);
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.05em;
    text-align: center;
  }

  /* ─── Responsive ─── */
  @media (max-width: 600px) {
    .demo-tabs { flex-direction: column; }
    .demo-comparison { flex-direction: column; }
    .demo-arrow {
      transform: rotate(90deg);
      margin: -0.25rem 0;
    }
    .demo-header { text-align: center; }
    .demo-header p { margin: 0 auto; }
  }

  /* ─── Reduced motion ─── */
  @media (prefers-reduced-motion: reduce) {
    .demo-panel {
      transition: opacity 0.15s;
      transform: none !important;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.demo-tab');
  const panels = document.querySelectorAll('.demo-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const scenario = tab.dataset.scenario;

      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      panels.forEach(p => p.classList.remove('active'));
      const target = document.querySelector(`[data-panel="${scenario}"]`);
      if (target) {
        // Small delay for exit animation
        requestAnimationFrame(() => {
          target.classList.add('active');
        });
      }
    });

    // Keyboard support
    tab.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        tab.click();
      }
    });
  });
</script>
