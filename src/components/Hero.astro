---
import { Image } from 'astro:assets';
import heroScreen from '../assets/screenshots/home-v2.PNG';
---

<section class="hero" id="hero">
  <div class="hero-bg">
    <div class="hero-gradient"></div>
    <div class="hero-particles"></div>
  </div>
  
  <div class="hero-content container">
    <div class="hero-text">
      <span class="hero-brand animate-in">Diamo</span>
      <div class="hero-badge animate-in">
        <span class="badge-dot"></span>
        <span data-i18n="hero.badge">Exklusiver Beta-Zugang</span>
      </div>
      <h1 class="hero-title animate-in" data-i18n="hero.title">
        Dein Fitness-Alltag, neu gedacht.
      </h1>
      
      <p class="hero-description animate-in" data-i18n="hero.description">
        Sei von Anfang an dabei und gestalte Diamo aktiv mit.
        Wir lesen jedes einzelne Feedback und deine Meinung formt die App.
        Lass uns zusammen die Fitness-App bauen, die dein Körper verdient.
      </p>
      
      <div class="hero-actions animate-in">
        <button type="button" class="btn btn-primary btn-hero-cta btn-shimmer" data-open-beta>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span data-i18n="hero.cta.beta">Als Beta-Testerin starten</span>
        </button>
      </div>
      
      <p class="hero-geo-definition animate-in" data-i18n="hero.geo">
        Diamo ist eine zyklusbasierte Fitness-App für Frauen, die Trainingspläne und Regeneration dynamisch an die hormonellen Phasen des weiblichen Zyklus anpasst.
      </p>

      <div class="hero-stats animate-in">
        <div class="stat">
          <span class="stat-value" data-i18n="hero.stat1.value">Begrenzt</span>
          <span class="stat-label" data-i18n="hero.stat1.label">Plätze verfügbar</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value" data-i18n="hero.stat2.value">100%</span>
          <span class="stat-label" data-i18n="hero.stat2.label">Kostenlos</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value" data-i18n="hero.stat3.value">Dein</span>
          <span class="stat-label" data-i18n="hero.stat3.label">Einfluss zählt</span>
        </div>
      </div>
    </div>
    
    <div class="hero-visual animate-in">
      <div class="phone-mockup">
        <div class="phone-frame">
          <div class="hero-dynamic-island"></div>
          <Image src={heroScreen} alt="Diamo App Startbildschirm" class="phone-screen" loading="eager" />
        </div>
      </div>
      <div class="hero-glow"></div>
    </div>
  </div>
</section>


<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: var(--nav-height);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 60% at 20% 50%, rgba(155, 139, 203, 0.1) 0%, transparent 70%),
      radial-gradient(ellipse 60% 80% at 80% 30%, rgba(185, 215, 234, 0.08) 0%, transparent 70%),
      radial-gradient(ellipse 50% 50% at 60% 80%, rgba(141, 198, 166, 0.06) 0%, transparent 70%),
      linear-gradient(180deg, var(--ivory) 0%, rgba(252, 251, 247, 0.95) 100%);
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(2px 2px at 20% 30%, rgba(155, 139, 203, 0.3), transparent),
      radial-gradient(2px 2px at 80% 20%, rgba(185, 215, 234, 0.3), transparent),
      radial-gradient(1.5px 1.5px at 60% 70%, rgba(196, 145, 142, 0.2), transparent),
      radial-gradient(1.5px 1.5px at 40% 80%, rgba(155, 139, 203, 0.2), transparent);
    animation: float 8s ease-in-out infinite;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  /* Exclusive Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    background: rgba(0, 32, 96, 0.06);
    border: 1px solid rgba(0, 32, 96, 0.1);
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
    width: fit-content;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--sage);
    border-radius: 50%;
    animation: pulseGlow 2s ease-in-out infinite;
    box-shadow: 0 0 8px rgba(141, 198, 166, 0.5);
  }

  .hero-brand {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--lavender);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-sm);
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1.08;
    margin-bottom: var(--space-md);
    font-variant-ligatures: no-common-ligatures;
    font-feature-settings: "liga" 0, "clig" 0;
  }

  .hero-accent {
    background: linear-gradient(135deg, var(--navy) 0%, var(--lavender) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  .btn-hero-cta {
    padding: 1.2rem 3rem;
    font-size: 1.1rem;
    font-weight: 700;
    box-shadow: 0 6px 28px rgba(0, 32, 96, 0.35);
    letter-spacing: 0.02em;
    position: relative;
    overflow: hidden;
  }

  .btn-hero-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 40px rgba(0, 32, 96, 0.45), 0 0 60px rgba(155, 139, 203, 0.15);
  }

  /* Shimmer effect on CTA */
  .btn-shimmer::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.15) 50%,
      transparent 100%
    );
    animation: shimmerSlide 3s ease-in-out infinite;
  }

  @keyframes shimmerSlide {
    0%, 100% { left: -100%; }
    50% { left: 150%; }
  }

  .hero-geo-definition {
    font-size: 0.82rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.6;
    max-width: 480px;
    margin-top: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-value {
    font-family: var(--font-sans);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--navy);
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background: var(--divider);
  }

  /* Phone Mockup */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: -90px;
  }

  .phone-mockup {
    position: relative;
    z-index: 2;
    animation: float 6s ease-in-out infinite;
  }

  .phone-frame {
    position: relative;
    width: 280px;
    background: #1a1a1a;
    border-radius: 38px;
    padding: 10px;
    box-shadow: 
      0 24px 70px rgba(0, 0, 0, 0.22),
      0 10px 24px rgba(0, 0, 0, 0.14),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset,
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .phone-frame::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 50%;
    background: linear-gradient(180deg, rgba(255,255,255,0.06) 0%, transparent 100%);
    border-radius: 38px;
    pointer-events: none;
    z-index: 3;
  }

  .hero-dynamic-island {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 20px;
    background: #000;
    border-radius: 12px;
    z-index: 4;
  }

  .phone-screen {
    width: 100%;
    border-radius: 30px;
    display: block;
  }

  .hero-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(155, 139, 203, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    z-index: 1;
    filter: blur(40px);
  }


  /* Stagger animations */
  .hero-text .animate-in:nth-child(1) { transition-delay: 0.1s; }
  .hero-text .animate-in:nth-child(2) { transition-delay: 0.2s; }
  .hero-text .animate-in:nth-child(3) { transition-delay: 0.3s; }
  .hero-text .animate-in:nth-child(4) { transition-delay: 0.4s; }
  .hero-text .animate-in:nth-child(5) { transition-delay: 0.5s; }
  .hero-text .animate-in:nth-child(6) { transition-delay: 0.6s; }
  .hero-text .animate-in:nth-child(7) { transition-delay: 0.7s; }
  .hero-visual.animate-in { transition-delay: 0.4s; }

  @media (max-width: 968px) {
    .hero {
      min-height: auto;
      padding-top: var(--nav-height);
      padding-bottom: var(--space-md);
    }

    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-md);
      padding-top: var(--space-md);
      padding-bottom: var(--space-sm);
    }

    .hero-badge {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-brand {
      margin-bottom: var(--space-xs);
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
      font-size: 0.95rem;
      max-width: 100%;
      margin-bottom: var(--space-sm);
    }

    .hero-actions {
      justify-content: center;
      margin-bottom: var(--space-sm);
    }

    .hero-stats {
      justify-content: center;
      gap: var(--space-sm);
    }

    .hero-visual {
      order: 1;
    }

    .phone-frame {
      width: 180px;
    }

    .hero-title {
      font-size: clamp(1.8rem, 7vw, 2.5rem);
      margin-bottom: var(--space-sm);
    }

    .btn-hero-cta {
      padding: 1rem 2rem;
      font-size: 0.95rem;
    }

    .stat-value {
      font-size: 1.1rem;
    }

    .stat-label {
      font-size: 0.65rem;
    }
  }
</style>
