---
---

<section class="hero" id="hero">
  <div class="hero-bg">
    <div class="hero-gradient"></div>
    <div class="hero-particles"></div>
  </div>
  
  <div class="hero-content container">
    <div class="hero-text">
      <div class="hero-brand animate-in">diamo</div>
      <h1 class="hero-title animate-in" data-i18n="hero.title">
        A New Era of<br/>Women's Health
      </h1>
      
      <p class="hero-description animate-in" data-i18n="hero.description">
        Personalized, cycle synced fitness powered by science. Diamo adapts 
        your workouts to your body's unique rhythm. Because your body 
        deserves better than one size fits all.
      </p>
      
      <div class="hero-actions animate-in">
        <a href="#waitlist" class="btn btn-primary btn-lg" data-open-waitlist>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <span data-i18n="hero.cta.waitlist">Join the Waitlist</span>
        </a>
        <a href="#features" class="btn btn-ghost">
          <span data-i18n="hero.cta.features">Explore Features</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17l9.2-9.2M17 17V7.8H7.8"/>
          </svg>
        </a>
      </div>
      
      <div class="hero-stats animate-in">
        <div class="stat">
          <span class="stat-value" data-i18n="hero.stat1.value">4</span>
          <span class="stat-label" data-i18n="hero.stat1.label">Training Modules</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value" data-i18n="hero.stat2.value">100%</span>
          <span class="stat-label" data-i18n="hero.stat2.label">Cycle Synced</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value" data-i18n="hero.stat3.value">∞</span>
          <span class="stat-label" data-i18n="hero.stat3.label">Community Power</span>
        </div>
      </div>
    </div>
    
    <div class="hero-visual animate-in">
      <div class="phone-mockup">
        <div class="phone-frame">
          <div class="phone-notch"></div>
          <img src="/screenshots/home-v2.png" alt="Diamo App Home Screen" class="phone-screen" />
        </div>
      </div>
      <div class="hero-glow"></div>
    </div>
  </div>
  
  <div class="hero-scroll-indicator">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: var(--nav-height);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 60% at 20% 50%, rgba(155, 139, 203, 0.08) 0%, transparent 70%),
      radial-gradient(ellipse 60% 80% at 80% 30%, rgba(185, 215, 234, 0.06) 0%, transparent 70%),
      linear-gradient(180deg, var(--ivory) 0%, rgba(252, 251, 247, 0.95) 100%);
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(2px 2px at 20% 30%, rgba(155, 139, 203, 0.3), transparent),
      radial-gradient(2px 2px at 80% 20%, rgba(185, 215, 234, 0.3), transparent),
      radial-gradient(1.5px 1.5px at 60% 70%, rgba(196, 145, 142, 0.2), transparent),
      radial-gradient(1.5px 1.5px at 40% 80%, rgba(155, 139, 203, 0.2), transparent);
    animation: float 8s ease-in-out infinite;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(0, 32, 96, 0.06);
    border: 1px solid rgba(0, 32, 96, 0.1);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--navy);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
    width: fit-content;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--sage);
    border-radius: 50%;
    animation: pulseGlow 2s ease-in-out infinite;
    box-shadow: 0 0 8px rgba(141, 198, 166, 0.5);
  }

  .hero-brand {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 700;
    color: var(--lavender);
    letter-spacing: 0.15em;
    text-transform: lowercase;
    margin-bottom: var(--space-sm);
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-md);
  }

  .hero-accent {
    background: linear-gradient(135deg, var(--navy) 0%, var(--lavender) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
    flex-wrap: wrap;
  }

  .btn-lg {
    padding: 1rem 2.25rem;
    font-size: 1rem;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--navy);
    background: none;
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-ghost:hover {
    gap: 0.75rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-value {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy);
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background: var(--divider);
  }

  /* Phone Mockup */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .phone-mockup {
    position: relative;
    z-index: 2;
    animation: float 6s ease-in-out infinite;
  }

  .phone-frame {
    position: relative;
    width: 280px;
    background: var(--soft-black);
    border-radius: 40px;
    padding: 12px;
    overflow: hidden;
    box-shadow: 
      0 20px 60px rgba(0, 32, 96, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset,
      0 -2px 6px rgba(255, 255, 255, 0.05) inset;
  }

  .phone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 28px;
    background: var(--soft-black);
    border-radius: 0 0 18px 18px;
    z-index: 3;
  }

  .phone-screen {
    width: 100%;
    border-radius: 30px;
    display: block;
    margin-top: -40px;
  }

  .hero-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(155, 139, 203, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    z-index: 1;
    filter: blur(40px);
  }

  /* Scroll Indicator */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, var(--navy), transparent);
    animation: fadeIn 2s ease-in-out infinite alternate;
  }

  /* Stagger animations */
  .hero-text .animate-in:nth-child(1) { transition-delay: 0.1s; }
  .hero-text .animate-in:nth-child(2) { transition-delay: 0.2s; }
  .hero-text .animate-in:nth-child(3) { transition-delay: 0.3s; }
  .hero-text .animate-in:nth-child(4) { transition-delay: 0.4s; }
  .hero-text .animate-in:nth-child(5) { transition-delay: 0.5s; }
  .hero-visual.animate-in { transition-delay: 0.4s; }

  @media (max-width: 968px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-stats {
      justify-content: center;
    }

    .hero-badge {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-visual {
      order: -1;
    }

    .phone-frame {
      width: 220px;
    }

    .hero-title {
      font-size: clamp(2rem, 8vw, 3rem);
    }
  }
</style>
