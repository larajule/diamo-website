---
---

<section class="hero" id="hero">
  <div class="hero-bg"></div>

  <div class="hero-content">
    <div class="hero-text">
      <h1 class="hero-headline animate-in" data-i18n="hero.title">
        Find your movement.<br/>Find your people.
      </h1>
      <p class="hero-sub animate-in" data-i18n="hero.description">
        Personalized fitness that adapts to your body, your energy, and your life. With a community that shows up in real life.
      </p>
      <div class="hero-actions animate-in">
        <button type="button" class="btn btn-light" data-open-beta>
          <span data-i18n="hero.cta.beta">Join Early Access</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div class="hero-visual animate-in">
      <div class="hero-phone">
        <img src="/screenshots/home-workout.png" alt="diamo app showing personalized workout" loading="eager" width="300" height="650"/>
      </div>
    </div>
  </div>

  <div class="hero-scroll-hint" id="hero-scroll-hint">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--navy-deep);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 65% 35%, rgba(44, 122, 255, 0.06) 0%, transparent 55%),
      linear-gradient(170deg, #001540 0%, #001d55 50%, #0a1628 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(3rem, 6vw, 6rem);
    max-width: var(--max-width);
    width: 100%;
    padding: calc(var(--nav-height) + var(--space-xl)) var(--space-md) var(--space-xl);
    min-height: calc(100vh - 4rem);
    min-height: calc(100dvh - 4rem);
    box-sizing: border-box;
  }

  .hero-text {
    flex: 1 1 55%;
    max-width: 580px;
  }

  .hero-headline {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--white);
    margin-bottom: var(--space-md);
  }

  .hero-sub {
    font-size: clamp(0.98rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    color: var(--text-inverse-muted);
    max-width: 440px;
    margin-bottom: var(--space-lg);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* ─── Phone ─── */
  .hero-visual {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-phone {
    width: clamp(220px, 20vw, 270px);
    border-radius: clamp(24px, 3.5vw, 38px);
    overflow: hidden;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .hero-phone img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ─── Scroll hint ─── */
  .hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.2);
    z-index: 2;
    animation: scrollDown 2.5s ease-in-out infinite;
  }

  @keyframes scrollDown {
    0%, 100% { opacity: 0.2; transform: translateX(-50%) translateY(0); }
    50% { opacity: 0.4; transform: translateX(-50%) translateY(5px); }
  }

  /* ─── Animate-in (no blur — GPU friendly) ─── */
  .hero .animate-in {
    transform: translateY(24px);
    transition: opacity 0.8s var(--ease-out),
                transform 0.8s var(--ease-out);
  }
  .hero .hero-text > .animate-in:nth-child(1) { transition-delay: 0.05s; }
  .hero .hero-text > .animate-in:nth-child(2) { transition-delay: 0.15s; }
  .hero .hero-text > .animate-in:nth-child(3) { transition-delay: 0.25s; }
  .hero .hero-visual.animate-in { transition-delay: 0.2s; }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .hero-content {
      flex-direction: column;
      text-align: center;
      align-items: center;
      justify-content: center;
      padding-top: calc(var(--nav-height) + var(--space-lg));
      gap: var(--space-lg);
    }
    .hero-text {
      align-items: center;
      display: flex;
      flex-direction: column;
      max-width: 480px;
    }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .hero-phone { width: clamp(200px, 45vw, 250px); }
  }

  @media (max-width: 480px) {
    .hero-headline { font-size: clamp(2rem, 8.5vw, 2.5rem); }
    .hero-phone { width: clamp(180px, 50vw, 220px); }
    .hero-scroll-hint { bottom: 1.2rem; }
  }
</style>

<script>
  // Show hero content immediately
  requestAnimationFrame(() => {
    document.querySelectorAll('.hero .animate-in').forEach(el => {
      el.classList.add('visible');
    });
  });

  // Fade scroll hint
  let hintHidden = false;
  window.addEventListener('scroll', () => {
    if (!hintHidden && window.scrollY > 80) {
      hintHidden = true;
      const h = document.getElementById('hero-scroll-hint');
      if (h) { h.style.transition = 'opacity 0.4s'; h.style.opacity = '0'; }
    }
  }, { passive: true });
</script>
