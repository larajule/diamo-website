---
---

<section class="screenshots section" id="screenshots">
  <div class="container">
    <div class="screenshots-header">
      <span class="section-label animate-in" data-i18n="screenshots.label">The App</span>
      <h2 class="section-title animate-in" data-i18n="screenshots.title">
        Designed to feel<br/>like second nature
      </h2>
      <p class="section-subtitle animate-in" data-i18n="screenshots.subtitle">
        A clean, intuitive interface that puts your wellbeing first. 
        Every screen crafted with intention.
      </p>
    </div>
    
    <div class="screenshots-showcase animate-in">
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <img src="/screenshots/home-v2.png" alt="Diamo Home Tab" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.home">Home</h4>
          <p data-i18n="screenshots.home.desc">Your daily dashboard with workouts, cycle rhythm, and motivational quotes</p>
        </div>
      </div>

      <div class="screenshot-item elevated">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <img src="/screenshots/insights_home.png" alt="Diamo Insights" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.insights">Insights</h4>
          <p data-i18n="screenshots.insights.desc">Daily health insights, cycle-based tips, and personalized recommendations</p>
        </div>
      </div>
      
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <img src="/screenshots/calendar.png" alt="Diamo Calendar" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.calendar">Calendar</h4>
          <p data-i18n="screenshots.calendar.desc">Cycle phase tracking with color coded workout types and daily planning</p>
        </div>
      </div>
      
      <div class="screenshot-item elevated">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <img src="/screenshots/community.png" alt="Diamo Community" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.community">Community</h4>
          <p data-i18n="screenshots.community.desc">Find local run clubs, studio events, and connect with friends nearby</p>
        </div>
      </div>
      
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <img src="/screenshots/personal.png" alt="Diamo Personal Profile" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.personal">Personal</h4>
          <p data-i18n="screenshots.personal.desc">Your cycle status, activity level, and personalized plan settings</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .screenshots {
    background: var(--white);
    overflow: hidden;
  }

  .screenshots-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .screenshots-header .section-subtitle {
    margin: 0 auto;
  }

  .screenshots-showcase {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .screenshot-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    transition: transform var(--transition-base);
  }

  .screenshot-item:hover {
    transform: translateY(-8px);
  }

  .screenshot-item.elevated {
    transform: translateY(-16px);
  }

  .screenshot-item.elevated:hover {
    transform: translateY(-24px);
  }

  .phone-wrapper {
    position: relative;
  }

  .mini-phone {
    width: 200px;
    background: var(--soft-black);
    border-radius: 28px;
    padding: 8px;
    box-shadow: 
      0 16px 48px rgba(0, 32, 96, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    transition: all var(--transition-base);
  }

  .mini-phone img {
    width: 100%;
    border-radius: 22px;
    display: block;
  }

  .screenshot-info {
    text-align: center;
    max-width: 180px;
  }

  .screenshot-info h4 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.3rem;
  }

  .screenshot-info p {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 968px) {
    .screenshots-showcase {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
    }

    .screenshot-item.elevated {
      transform: none;
    }

    .screenshot-item.elevated:hover {
      transform: translateY(-8px);
    }

    .mini-phone {
      width: 100%;
      max-width: 200px;
      margin: 0 auto;
    }
  }

  @media (max-width: 520px) {
    .screenshots-showcase {
      grid-template-columns: 1fr;
    }

    .mini-phone {
      width: 200px;
    }
  }
</style>
