---
---

<section class="screenshots section" id="screenshots">
  <div class="container">
    <div class="screenshots-header">
      <span class="section-label animate-in" data-i18n="screenshots.label">Die App</span>
      <h2 class="section-title animate-in" data-i18n="screenshots.title">
        Designt, um sich<br/>natürlich anzufühlen
      </h2>
      <p class="section-subtitle animate-in" data-i18n="screenshots.subtitle">
        Ein klares, intuitives Interface, das dein Wohlbefinden in den Vordergrund stellt. 
        Jeder Screen mit Intention gestaltet.
      </p>
    </div>
    
    <div class="screenshots-showcase animate-in">
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <img
            src="/screenshots/home.png"
            alt="diamo Home-Tab"
            class="flat-mockup-img"
            loading="lazy"
          />
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.home">Home</h4>
          <p data-i18n="screenshots.home.desc">Dein tägliches Dashboard mit Workouts, Zyklusrhythmus und Motivationssprüchen</p>
        </div>
      </div>

      <div class="screenshot-item elevated">
        <div class="phone-wrapper">
          <img
            src="/screenshots/calendar.png"
            alt="diamo Kalender-Tab"
            class="flat-mockup-img"
            loading="lazy"
          />
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.calendar">Kalender</h4>
          <p data-i18n="screenshots.calendar.desc">Zyklusphase-Tracking mit farbcodierten Trainingstypen und Tagesplanung</p>
        </div>
      </div>
      
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <img
            src="/screenshots/community.png"
            alt="diamo Community-Tab"
            class="flat-mockup-img"
            loading="lazy"
          />
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.community">Community</h4>
          <p data-i18n="screenshots.community.desc">Finde lokale Laufgruppen, Studio-Events und vernetze dich mit Freundinnen</p>
        </div>
      </div>
      
      <div class="screenshot-item elevated">
        <div class="phone-wrapper">
          <img
            src="/screenshots/personal.png"
            alt="diamo Persönliches Profil"
            class="flat-mockup-img"
            loading="lazy"
          />
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.personal">Persönlich</h4>
          <p data-i18n="screenshots.personal.desc">Dein Zyklusstatus, Aktivitätslevel und personalisierte Plan-Einstellungen</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .screenshots {
    background: var(--white);
    overflow: hidden;
  }

  .screenshots-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .screenshots-header .section-subtitle {
    margin: 0 auto;
  }

  .screenshots-showcase {
    display: grid;
    grid-template-columns: repeat(4, 200px);
    justify-content: center;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .screenshot-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    transition: transform 0.3s ease;
  }

  .screenshot-item:hover .phone-wrapper {
    transform: translateY(-8px);
  }

  .screenshot-item.elevated .phone-wrapper {
    transform: translateY(-16px);
  }

  .screenshot-item.elevated:hover .phone-wrapper {
    transform: translateY(-24px);
  }

  /* Neue Flat-Mockup-Bilder: haben eigenen Phone-Frame */
  .flat-mockup-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto;
    filter: drop-shadow(0 16px 40px rgba(0, 32, 96, 0.14)) drop-shadow(0 4px 12px rgba(0,0,0,0.06));
    transition: filter var(--transition-base);
  }

  .phone-wrapper:hover .flat-mockup-img {
    filter: drop-shadow(0 24px 56px rgba(0, 32, 96, 0.2)) drop-shadow(0 8px 20px rgba(155, 139, 203, 0.15));
  }

  .screenshot-info {
    text-align: center;
    max-width: 180px;
    min-height: 90px;
  }

  .screenshot-info h4 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.3rem;
  }

  .screenshot-info p {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 968px) {
    .screenshots-showcase {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
    }

    .screenshot-item.elevated {
      transform: none;
    }

    .screenshot-item.elevated:hover {
      transform: translateY(-8px);
    }

    .phone-wrapper {
      width: 100%;
      max-width: 220px;
      margin: 0 auto;
    }
  }

  @media (max-width: 520px) {
    .screenshots-showcase {
      grid-template-columns: 1fr;
    }

    .phone-wrapper {
      max-width: 240px;
    }
  }
</style>
