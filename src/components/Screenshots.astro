---
import { Image } from 'astro:assets';
import homeScreen from '../assets/screenshots/home-v2.png';
import insightsScreen from '../assets/screenshots/insights_home.png';
import calendarScreen from '../assets/screenshots/calendar.png';
import communityScreen from '../assets/screenshots/community.png';
import personalScreen from '../assets/screenshots/personal.png';
---

<section class="screenshots section" id="screenshots">
  <div class="container">
    <div class="screenshots-header">
      <span class="section-label animate-in" data-i18n="screenshots.label">Die App</span>
      <h2 class="section-title animate-in" data-i18n="screenshots.title">
        Designt, um sich<br/>natürlich anzufühlen
      </h2>
      <p class="section-subtitle animate-in" data-i18n="screenshots.subtitle">
        Ein klares, intuitives Interface, das dein Wohlbefinden in den Vordergrund stellt. 
        Jeder Screen mit Intention gestaltet.
      </p>
    </div>
    
    <div class="screenshots-showcase animate-in">
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <Image src={homeScreen} alt="Diamo Home-Tab" loading="lazy" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.home">Home</h4>
          <p data-i18n="screenshots.home.desc">Dein tägliches Dashboard mit Workouts, Zyklusrhythmus und Motivationssprüchen</p>
        </div>
      </div>

      <div class="screenshot-item elevated">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <Image src={insightsScreen} alt="Diamo Einblicke-Tab" loading="lazy" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.insights">Einblicke</h4>
          <p data-i18n="screenshots.insights.desc">Tägliche Gesundheits-Einblicke, zyklusbasierte Tipps und personalisierte Empfehlungen</p>
        </div>
      </div>
      
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <Image src={calendarScreen} alt="Diamo Kalender-Tab" loading="lazy" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.calendar">Kalender</h4>
          <p data-i18n="screenshots.calendar.desc">Zyklusphase-Tracking mit farbcodierten Trainingstypen und Tagesplanung</p>
        </div>
      </div>
      
      <div class="screenshot-item elevated">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <Image src={communityScreen} alt="Diamo Community-Tab" loading="lazy" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.community">Community</h4>
          <p data-i18n="screenshots.community.desc">Finde lokale Laufgruppen, Studio-Events und vernetze dich mit Freundinnen</p>
        </div>
      </div>
      
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <Image src={personalScreen} alt="Diamo Persönliches Profil" loading="lazy" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4 data-i18n="screenshots.personal">Persönlich</h4>
          <p data-i18n="screenshots.personal.desc">Dein Zyklusstatus, Aktivitätslevel und personalisierte Plan-Einstellungen</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .screenshots {
    background: var(--white);
    overflow: hidden;
  }

  .screenshots-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .screenshots-header .section-subtitle {
    margin: 0 auto;
  }

  .screenshots-showcase {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .screenshot-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    transition: transform var(--transition-base);
  }

  .screenshot-item:hover {
    transform: translateY(-8px);
  }

  .screenshot-item.elevated {
    transform: translateY(-16px);
  }

  .screenshot-item.elevated:hover {
    transform: translateY(-24px);
  }

  .phone-wrapper {
    position: relative;
  }

  .mini-phone {
    width: 200px;
    background: var(--soft-black);
    border-radius: 28px;
    padding: 8px;
    box-shadow: 
      0 16px 48px rgba(0, 32, 96, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    transition: all var(--transition-base);
  }

  .mini-phone img {
    width: 100%;
    border-radius: 22px;
    display: block;
  }

  .screenshot-info {
    text-align: center;
    max-width: 180px;
  }

  .screenshot-info h4 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.3rem;
  }

  .screenshot-info p {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 968px) {
    .screenshots-showcase {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
    }

    .screenshot-item.elevated {
      transform: none;
    }

    .screenshot-item.elevated:hover {
      transform: translateY(-8px);
    }

    .mini-phone {
      width: 100%;
      max-width: 200px;
      margin: 0 auto;
    }
  }

  @media (max-width: 520px) {
    .screenshots-showcase {
      grid-template-columns: 1fr;
    }

    .mini-phone {
      width: 200px;
    }
  }
</style>
