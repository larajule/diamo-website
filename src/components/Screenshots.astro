---
---

<section class="screenshots section" id="screenshots">
  <div class="container">
    <div class="screenshots-header">
      <span class="section-label animate-in">The App</span>
      <h2 class="section-title animate-in">
        Designed to feel<br/>like second nature.
      </h2>
      <p class="section-subtitle animate-in">
        A clean, intuitive interface that puts your wellbeing first — 
        every screen crafted with intention.
      </p>
    </div>
    
    <div class="screenshots-showcase animate-in">
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <img src="/screenshots/home.png" alt="Diamo Home Tab" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4>Home</h4>
          <p>Your daily dashboard with workouts, cycle rhythm, and community stories</p>
        </div>
      </div>
      
      <div class="screenshot-item featured">
        <div class="phone-wrapper">
          <div class="mini-phone large">
            <img src="/screenshots/screen2.png" alt="Diamo App Screen" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4>Workout</h4>
          <p>Personalized sessions adapted to your energy and cycle phase</p>
        </div>
      </div>
      
      <div class="screenshot-item">
        <div class="phone-wrapper">
          <div class="mini-phone">
            <img src="/screenshots/calendar.png" alt="Diamo Calendar" />
          </div>
        </div>
        <div class="screenshot-info">
          <h4>Calendar</h4>
          <p>Cycle tracking with daily workout overview and rest day planning</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .screenshots {
    background: var(--white);
    overflow: hidden;
  }

  .screenshots-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .screenshots-header .section-subtitle {
    margin: 0 auto;
  }

  .screenshots-showcase {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .screenshot-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    transition: transform var(--transition-base);
  }

  .screenshot-item:hover {
    transform: translateY(-8px);
  }

  .phone-wrapper {
    position: relative;
  }

  .mini-phone {
    width: 200px;
    background: var(--soft-black);
    border-radius: 28px;
    padding: 8px;
    box-shadow: 
      0 16px 48px rgba(0, 32, 96, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    transition: all var(--transition-base);
  }

  .mini-phone.large {
    width: 240px;
    border-radius: 32px;
    padding: 10px;
    box-shadow: 
      0 24px 64px rgba(0, 32, 96, 0.2),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
  }

  .mini-phone img {
    width: 100%;
    border-radius: 22px;
    display: block;
  }

  .mini-phone.large img {
    border-radius: 24px;
  }

  .screenshot-info {
    text-align: center;
    max-width: 200px;
  }

  .screenshot-info h4 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.3rem;
  }

  .screenshot-info p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .featured {
    transform: translateY(-20px);
  }

  .featured:hover {
    transform: translateY(-28px);
  }

  @media (max-width: 768px) {
    .screenshots-showcase {
      flex-direction: column;
      align-items: center;
    }

    .featured {
      transform: none;
      order: -1;
    }

    .featured:hover {
      transform: translateY(-8px);
    }

    .mini-phone {
      width: 180px;
    }

    .mini-phone.large {
      width: 220px;
    }
  }
</style>
