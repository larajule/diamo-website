---
---

<section class="screenshots section" id="screenshots">
  <div class="screenshots-header container">
    <span class="section-label animate-in" data-i18n="screenshots.label">Die App</span>
    <h2 class="section-title animate-in" data-i18n="screenshots.title">
      Designt, um sich<br/>natürlich anzufühlen
    </h2>
    <p class="section-subtitle animate-in" data-i18n="screenshots.subtitle">
      Ein klares, intuitives Interface, das dein Wohlbefinden in den Vordergrund stellt. 
      Jeder Screen mit Intention gestaltet.
    </p>
  </div>

  <div class="screenshots-stage animate-in">
    <div class="phones-row">

      <div class="phone-col side-col">
        <div class="phone-wrap">
          <img src="/screenshots/community.png" alt="diamo Community-Tab" class="phone-img" loading="lazy" />
        </div>
        <div class="phone-label">
          <h4 data-i18n="screenshots.community">Community</h4>
          <p data-i18n="screenshots.community.desc">Finde lokale Laufgruppen, Studio-Events und vernetze dich mit Freundinnen</p>
        </div>
      </div>

      <div class="phone-col left-col">
        <div class="phone-wrap">
          <img src="/screenshots/home.png" alt="diamo Home-Tab" class="phone-img" loading="lazy" />
        </div>
        <div class="phone-label">
          <h4 data-i18n="screenshots.home">Home</h4>
          <p data-i18n="screenshots.home.desc">Dein tägliches Dashboard mit Workouts, Zyklusrhythmus und Motivationssprüchen</p>
        </div>
      </div>

      <div class="phone-col center-col">
        <div class="phone-wrap">
          <img src="/screenshots/calendar.png" alt="diamo Kalender-Tab" class="phone-img" loading="lazy" />
        </div>
        <div class="phone-label">
          <h4 data-i18n="screenshots.calendar">Kalender</h4>
          <p data-i18n="screenshots.calendar.desc">Zyklusphase-Tracking mit farbcodierten Trainingstypen und Tagesplanung</p>
        </div>
      </div>

      <div class="phone-col right-col">
        <div class="phone-wrap">
          <img src="/screenshots/personal.png" alt="diamo Persönliches Profil" class="phone-img" loading="lazy" />
        </div>
        <div class="phone-label">
          <h4 data-i18n="screenshots.personal">Persönlich</h4>
          <p data-i18n="screenshots.personal.desc">Dein Zyklusstatus, Aktivitätslevel und personalisierte Plan-Einstellungen</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .screenshots {
    background: var(--white);
    overflow: hidden;
    padding-top: var(--space-2xl);
    /* generous bottom padding so shadows breathe */
    padding-bottom: 0;
  }

  .screenshots-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .screenshots-header .section-subtitle {
    margin: 0 auto;
  }

  /* ── Stage ─────────────────────────────────────── */
  /* Full-bleed container so phones can overflow freely */
  .screenshots-stage {
    width: 100%;
    /* overflow-x clip lets vertical shadows breathe while hiding horizontal spill */
    overflow-x: clip;
    overflow-y: visible;
    /* extra top + bottom room for drop-shadows */
    padding: 2rem 0 5rem;
  }

  /* ── Phones row ─────────────────────────────────── */
  .phones-row {
    display: flex;
    justify-content: center;
    align-items: flex-end;   /* anchor to bottom so stagger reads upward */
    gap: 0;                  /* overlap is controlled by negative margin on each col */
    /* let the row be wider than viewport if needed */
    min-width: min-content;
    margin: 0 auto;
    max-width: 1320px;
    padding: 0 2rem;
  }

  /* ── Shared column ─────────────────────────────── */
  .phone-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 0 0 auto;
    /* columns overlap for a cohesive cluster feel */
    margin-left: -4%;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .phone-col:first-child {
    margin-left: 0;
  }

  /* ── Phone wrapper ─────────────────────────────── */
  .phone-wrap {
    position: relative;
    /* drop-shadow instead of box-shadow so it follows the PNG outline exactly */
    filter:
      drop-shadow(0px 24px 48px rgba(0, 32, 96, 0.13))
      drop-shadow(0px 4px 16px rgba(0, 32, 96, 0.08));
    transition: filter 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    /* leave top/bottom padding so shadows aren't clipped at wrapper edge */
    padding: 1rem 0.5rem;
  }

  .phone-col:hover .phone-wrap {
    filter:
      drop-shadow(0px 36px 64px rgba(0, 32, 96, 0.18))
      drop-shadow(0px 8px 24px rgba(155, 139, 203, 0.2));
    transform: translateY(-12px);
  }

  /* ── Phone image ───────────────────────────────── */
  .phone-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    /* counteract the large transparent padding in the PNGs so phones read bigger */
    /* PNG has roughly 8% padding on each side */
  }

  /* ── Per-column sizes & vertical alignment ─────── */

  /* All phones: same size, same baseline */
  .side-col {
    width: 400px;
    transform: translateY(0px);
    z-index: 1;
  }

  .left-col,
  .right-col {
    width: 400px;
    transform: translateY(0px);
    z-index: 2;
  }

  .center-col {
    width: 400px;
    transform: translateY(0px);
    z-index: 3;
  }

  /* uniform hover lift */
  .side-col:hover,
  .left-col:hover,
  .right-col:hover,
  .center-col:hover {
    transform: translateY(-12px);
  }

  /* ── Labels ────────────────────────────────────── */
  .phone-label {
    text-align: center;
    padding: 1rem 0.75rem 0;
    max-width: 280px;
    /* labels are part of the stagger so keep them attached to each col */
  }

  .phone-label h4 {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .phone-label p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    max-width: none;
  }

  /* ── Tablet ─────────────────────────────────────── */
  @media (max-width: 900px) {
    .phones-row {
      gap: 0;
      padding: 0 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .phone-col {
      margin-left: 0;
    }

    /* show as 2×2 grid with subtle stagger */
    .side-col,
    .left-col,
    .right-col,
    .center-col {
      width: 46%;
      max-width: 240px;
      transform: translateY(0) !important;
    }

    .side-col:hover,
    .left-col:hover,
    .right-col:hover,
    .center-col:hover {
      transform: translateY(-8px) !important;
    }

    .screenshots-stage {
      padding-bottom: 3rem;
    }
  }

  /* ── Mobile ─────────────────────────────────────── */
  @media (max-width: 540px) {
    .phones-row {
      flex-direction: column;
      align-items: center;
    }

    .side-col,
    .left-col,
    .right-col,
    .center-col {
      width: 80%;
      max-width: 300px;
    }
  }
</style>
