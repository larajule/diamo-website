---
---
<section class="appteaser" id="app">
  <div class="container">
    <div class="appteaser-header">
      <span class="section-label" data-i18n="appteaser.label">the app</span>
      <h2 class="appteaser-headline" data-i18n="appteaser.headline">SAME GIRL. DIFFERENT DAY.</h2>
    </div>

    <!-- Tab nav -->
    <div class="tab-nav" role="tablist" aria-label="App screens">
      <button class="tab-btn active" role="tab" aria-selected="true" data-tab="home">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span data-i18n="appteaser.tab.home">Home</span>
      </button>
      <button class="tab-btn" role="tab" aria-selected="false" data-tab="calendar">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span data-i18n="appteaser.tab.calendar">Calendar</span>
      </button>
      <button class="tab-btn" role="tab" aria-selected="false" data-tab="community">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span data-i18n="appteaser.tab.community">Community</span>
      </button>
      <button class="tab-btn" role="tab" aria-selected="false" data-tab="personal">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span data-i18n="appteaser.tab.personal">Personal</span>
      </button>
    </div>

    <!-- Tab panels -->
    <div class="tab-panels">

      <div class="tab-panel active" data-panel="home">
        <div class="panel-phone">
          <div class="phone-frame">
            <img src="/images/screen-home.jpg" alt="diamo Home" />
          </div>
        </div>
        <div class="panel-copy">
          <span class="panel-eyebrow" data-i18n="appteaser.home.label">HOME</span>
          <h3 data-i18n="appteaser.home.headline">YOUR DAY. YOUR MOVE.</h3>
          <p data-i18n="appteaser.home.desc">Personalized movement that responds to your goals, schedule and recovery needs.</p>
        </div>
      </div>

      <div class="tab-panel" data-panel="calendar">
        <div class="panel-phone">
          <div class="phone-frame">
            <img src="/images/screen-calendar.jpg" alt="diamo Calendar" />
          </div>
        </div>
        <div class="panel-copy">
          <span class="panel-eyebrow" data-i18n="appteaser.calendar.label">CALENDAR</span>
          <h3 data-i18n="appteaser.calendar.headline">YOUR PLAN. YOUR PACE.</h3>
          <p data-i18n="appteaser.calendar.desc">Your movement plan, organized around your week.</p>
        </div>
      </div>

      <div class="tab-panel" data-panel="community">
        <div class="panel-phone">
          <div class="phone-frame">
            <img src="/images/screen-community.jpg" alt="diamo Community" />
          </div>
        </div>
        <div class="panel-copy">
          <span class="panel-eyebrow" data-i18n="appteaser.community.label">COMMUNITY</span>
          <h3 data-i18n="appteaser.community.headline">FIND YOUR PEOPLE.</h3>
          <p data-i18n="appteaser.community.desc">Movement and real-life connections with other women.</p>
        </div>
      </div>

      <div class="tab-panel" data-panel="personal">
        <div class="panel-phone">
          <div class="phone-frame">
            <img src="/images/screen-personal.jpg" alt="diamo Personal" />
          </div>
        </div>
        <div class="panel-copy">
          <span class="panel-eyebrow" data-i18n="appteaser.personal.label">PERSONAL</span>
          <h3 data-i18n="appteaser.personal.headline">MORE THAN A NUMBER.</h3>
          <p data-i18n="appteaser.personal.desc">Understand your progress and discover your personal patterns.</p>
        </div>
      </div>

    </div>

    <div class="appteaser-cta">
      <button class="btn-get-access" data-open-beta data-i18n="appteaser.cta">Get Early Access</button>
    </div>

    <!-- Movement Pillars -->
    <div class="pillars-wrap">
      <div class="pillars-label" data-i18n="appteaser.pillars.label">movement pillars</div>
      <div class="pillars-row">
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6.5 6.5h11M6.5 17.5h11M3 10h18M3 14h18"/>
          </svg>
          <span class="pillar-name" data-i18n="appteaser.pillar1.name">STRENGTH</span>
          <span class="pillar-desc" data-i18n="appteaser.pillar1.desc">Build strength for the long game.</span>
        </div>
        <div class="pillar-divider"></div>
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
          <span class="pillar-name" data-i18n="appteaser.pillar2.name">ENDURANCE</span>
          <span class="pillar-desc" data-i18n="appteaser.pillar2.desc">Move for your heart and your future.</span>
        </div>
        <div class="pillar-divider"></div>
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
          </svg>
          <span class="pillar-name" data-i18n="appteaser.pillar3.name">MOBILITY</span>
          <span class="pillar-desc" data-i18n="appteaser.pillar3.desc">Keep moving freely.</span>
        </div>
        <div class="pillar-divider"></div>
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="pillar-name" data-i18n="appteaser.pillar4.name">RECOVERY</span>
          <span class="pillar-desc" data-i18n="appteaser.pillar4.desc">Rest is part of the plan.</span>
        </div>
      </div>
      <p class="pillars-note" data-i18n="appteaser.pillars.note">Different goals. Different schedules. Different energy. One approach that adapts to you.</p>
    </div>

  </div>
</section>

<style>
  .appteaser {
    background: var(--ivory, #FCFBF7);
    padding: 7rem 2rem 6rem;
  }

  .appteaser-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .appteaser-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--navy, #0C2A6E);
    margin: 0.6rem 0 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.0;
  }

  .appteaser-sub {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: rgba(12,42,110,0.5);
    margin: 0;
  }

  /* Tab nav */
  .tab-nav {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.55rem 1.1rem;
    border-radius: 100px;
    border: 1.5px solid rgba(12,42,110,0.18);
    background: transparent;
    color: rgba(12,42,110,0.55);
    cursor: pointer;
    transition: all 0.2s;
  }

  .tab-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .tab-btn.active,
  .tab-btn:hover {
    background: var(--navy, #0C2A6E);
    color: #fff;
    border-color: var(--navy, #0C2A6E);
  }

  /* Tab panels */
  .tab-panels {
    max-width: 900px;
    margin: 0 auto;
  }

  .tab-panel {
    display: none;
    grid-template-columns: auto 1fr;
    gap: 5rem;
    align-items: center;
  }

  .tab-panel.active {
    display: grid;
  }

  /* Phone frame */
  .panel-phone {
    display: flex;
    justify-content: center;
  }

  .phone-frame {
    width: 220px;
    border-radius: 28px;
    overflow: hidden;
    box-shadow:
      0 0 0 2px rgba(12,42,110,0.08),
      0 24px 64px rgba(12,42,110,0.18),
      0 4px 16px rgba(12,42,110,0.1);
    background: #EEF4FB;
  }

  .phone-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Copy */
  .panel-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .panel-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--cobalt, #1535A8);
  }

  .panel-copy h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--navy, #0C2A6E);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }

  .panel-copy p {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: rgba(12,42,110,0.6);
    line-height: 1.65;
    margin: 0;
    max-width: 360px;
  }

  .in-dev-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    border: 1.5px solid rgba(12,42,110,0.2);
    color: rgba(12,42,110,0.45);
    width: fit-content;
  }

  /* CTA */
  .appteaser-cta {
    text-align: center;
    margin-top: 4rem;
  }

  .btn-get-access {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.9rem 2.5rem;
    border-radius: 100px;
    border: none;
    background: var(--navy, #0C2A6E);
    color: #fff;
    cursor: pointer;
    transition: all 0.25s;
    box-shadow: 0 4px 16px rgba(12,42,110,0.2);
  }

  .btn-get-access:hover {
    background: var(--cobalt, #1535A8);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(21,53,168,0.3);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .appteaser { padding: 5rem 1.5rem; }

    .tab-panel.active {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
      align-items: center;
    }

    .phone-frame {
      width: 180px;
    }

    .panel-copy {
      text-align: center;
      align-items: center;
    }

    .panel-copy p { max-width: 100%; }
  }

  /* ── Movement Pillars ── */
  .pillars-wrap {
    margin-top: 5rem;
    padding-top: 4rem;
    border-top: 1px solid rgba(12,42,110,0.08);
    text-align: center;
  }

  .pillars-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(12,42,110,0.35);
    margin-bottom: 2.5rem;
  }

  .pillars-row {
    display: flex;
    gap: 0;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    max-width: 800px;
    margin: 0 auto 2rem;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 0 2.5rem;
    flex: 1;
    min-width: 140px;
  }

  .pillar-icon {
    width: 24px;
    height: 24px;
    color: var(--cobalt, #1535A8);
    opacity: 0.7;
  }

  .pillar-name {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--navy, #0C2A6E);
  }

  .pillar-desc {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgba(12,42,110,0.5);
    text-align: center;
  }

  .pillar-divider {
    width: 1px;
    height: 60px;
    background: rgba(12,42,110,0.1);
    flex-shrink: 0;
    align-self: center;
  }

  .pillars-note {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(12,42,110,0.4);
    max-width: 480px;
    margin: 0 auto;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .pillar-divider { display: none; }
    .pillars-row { gap: 1.5rem; }
    .pillar { padding: 0 1rem; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var tabs = document.querySelectorAll('.appteaser .tab-btn');
    var panels = document.querySelectorAll('.appteaser .tab-panel');

    tabs.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var target = btn.getAttribute('data-tab');
        tabs.forEach(function(t) {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(function(p) { p.classList.remove('active'); });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        var panel = document.querySelector('.appteaser .tab-panel[data-panel="' + target + '"]');
        if (panel) panel.classList.add('active');
      });
    });
  });
</script>
