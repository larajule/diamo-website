---
const team = [
  {
    name: 'Lara Bullemer',
    role: 'Co-Founder',
    focus: 'Creative & Growth',
    image: '/team/lara.png',
    bio: 'Fokus auf Frauengesundheit in Einklang mit Marketing & Logiken: Medizinische Tiefe (angehende Heilpraktikerin). Kreativ-Direktion: Markenführung auf dem Niveau globaler Lifestyle-Brands (Erfahrung in der Filmbranche & Digital Media Studium). Management-Expertise (BWL Master).',
    tags: ['Creative Direction', 'Women\'s Health', 'Brand Strategy']
  },
  {
    name: 'Marie Westermann',
    role: 'Co-Founder',
    focus: 'Strategy & Operations',
    image: '/team/marie.png',
    bio: 'Fokus auf operative Exzellenz und den Aufbau der Community Strukturen. Beratungserfahrung bei Inverto (BCG Company) sowie Investment Know-how bei Coparion. Fachliche Tiefe als lizenzierte Fitness Trainerin mit B-Lizenz.',
    tags: ['Strategy', 'Operations', 'Fitness']
  }
];

const openRoles = [
  {
    title: 'Technical Co-Founder',
    description: 'Build the core community logic and a stable, scalable app architecture. Focus on user interaction and technical scalability.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`
  },
  {
    title: 'Co-Founder: Influencerin',
    description: 'Build an authentic community through social media recommendations. Trust over advertising.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>`
  }
];
---

<section class="team section" id="team">
  <div class="container">
    <div class="team-header">
      <span class="section-label animate-in">The Team</span>
      <h2 class="section-title animate-in">
        Built by women,<br/>for women.
      </h2>
      <p class="section-subtitle animate-in">
        A team combining management expertise, fitness science, 
        and creative direction to redefine women's health.
      </p>
    </div>
    
    <div class="team-grid">
      {team.map((member, i) => (
        <div class="team-card animate-in" style={`transition-delay: ${0.1 + i * 0.15}s`}>
          <div class="team-image-wrapper">
            <img src={member.image} alt={member.name} class="team-image" />
            <div class="team-image-overlay"></div>
          </div>
          <div class="team-info">
            <h3 class="team-name">{member.name}</h3>
            <span class="team-role">{member.role}</span>
            <span class="team-focus">{member.focus}</span>
            <p class="team-bio">{member.bio}</p>
            <div class="team-tags">
              {member.tags.map(tag => (
                <span class="team-tag">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="open-roles animate-in">
      <h3 class="open-roles-title">We're looking for visionaries</h3>
      <div class="open-roles-grid">
        {openRoles.map((role, i) => (
          <div class="role-card" style={`transition-delay: ${0.3 + i * 0.1}s`}>
            <div class="role-icon">
              <Fragment set:html={role.icon} />
            </div>
            <div class="role-info">
              <h4 class="role-title">{role.title}</h4>
              <p class="role-description">{role.description}</p>
            </div>
            <a href="#contact" class="role-apply">
              Apply
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17l9.2-9.2M17 17V7.8H7.8"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .team {
    background: var(--white);
  }

  .team-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .team-header .section-subtitle {
    margin: 0 auto;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .team-card {
    background: var(--ivory);
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--divider);
    transition: all var(--transition-base);
  }

  .team-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .team-image-wrapper {
    position: relative;
    height: 320px;
    overflow: hidden;
  }

  .team-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .team-card:hover .team-image {
    transform: scale(1.03);
  }

  .team-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(0, 32, 96, 0.05) 100%);
  }

  .team-info {
    padding: var(--space-lg);
  }

  .team-name {
    font-family: var(--font-sans);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.3rem;
  }

  .team-role {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--lavender);
    display: block;
  }

  .team-focus {
    font-size: 0.8rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .team-bio {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .team-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .team-tag {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    background: rgba(0, 32, 96, 0.04);
    border-radius: var(--radius-full);
    color: var(--navy);
    letter-spacing: 0.03em;
  }

  /* Open Roles */
  .open-roles-title {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy);
    text-align: center;
    margin-bottom: var(--space-md);
  }

  .open-roles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  .role-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--ivory);
    border: 1px dashed var(--divider);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .role-card:hover {
    border-style: solid;
    border-color: var(--lavender);
    background: rgba(155, 139, 203, 0.03);
  }

  .role-icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: rgba(155, 139, 203, 0.08);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lavender);
  }

  .role-info {
    flex-grow: 1;
  }

  .role-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.2rem;
  }

  .role-description {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .role-apply {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--lavender);
    white-space: nowrap;
    transition: gap var(--transition-fast);
  }

  .role-apply:hover {
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr;
    }

    .open-roles-grid {
      grid-template-columns: 1fr;
    }

    .team-image-wrapper {
      height: 260px;
    }
  }
</style>
