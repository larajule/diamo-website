---
import { Image } from 'astro:assets';
import betaLifestyle from '../assets/images/beta-workout-girl.jpg';
---

<section class="beta-signup" id="beta">
  <div class="beta-dark">
    <div class="container">
      <div class="beta-inner">
        <div class="beta-text animate-in">
          <h2 class="beta-headline" data-i18n="beta.title">
            Begrenzte Plätze.<br/>Einer könnte deiner sein.
          </h2>
          <p class="beta-sub" data-i18n="beta.description">
            Die Beta startet bald mit einer kleinen, exklusiven Gruppe. Du testest diamo kostenlos, gibst Feedback und formst die App, bevor sie alle anderen sehen. Founding Members erhalten besondere Vorteile zum Launch.
          </p>
          <div class="beta-actions">
            <button type="button" class="btn btn-beta-cta" data-open-beta>
              <span data-i18n="beta.cta">Jetzt Platz sichern</span>
            </button>
            <span class="beta-note" data-i18n="beta.note">Begrenzte Plätze · Kostenlos · Founding Member Vorteile</span>
          </div>
        </div>
        <div class="beta-visual animate-in">
          <Image src={betaLifestyle} alt="Frau mit Workout App" class="beta-img" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .beta-signup {
    padding: 0;
  }

  .beta-dark {
    background: linear-gradient(135deg, #0a1628 0%, var(--navy) 40%, #1a2a4a 100%);
    padding: var(--space-3xl) 0;
    position: relative;
    overflow: hidden;
  }

  .beta-dark::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 60% 60% at 20% 80%, rgba(155, 139, 203, 0.12) 0%, transparent 70%),
      radial-gradient(ellipse 50% 50% at 80% 20%, rgba(141, 198, 166, 0.08) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 50% 50%, rgba(185, 215, 234, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .beta-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .beta-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    line-height: 1.1;
    color: var(--white);
    margin-bottom: var(--space-md);
    letter-spacing: -0.01em;
  }

  .beta-sub {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: var(--space-lg);
    max-width: 480px;
  }

  .beta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .btn-beta-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1.1rem 2.5rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    border: none;
    cursor: pointer;
    background: var(--white);
    color: var(--navy);
    transition: all var(--transition-base);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .btn-beta-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }

  .beta-note {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.02em;
  }

  .beta-visual {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .beta-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: top center;
    display: block;
    border-radius: var(--radius-lg);
    transition: transform var(--transition-slow);
  }

  .beta-visual:hover .beta-img {
    transform: scale(1.03);
  }

  .beta-text.animate-in { transition-delay: 0.1s; }
  .beta-visual.animate-in { transition-delay: 0.3s; }

  @media (max-width: 768px) {
    .beta-dark {
      padding: var(--space-2xl) 0;
    }

    .beta-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .beta-visual {
      order: -1;
    }

    .beta-img {
      height: 320px;
    }

    .beta-actions {
      justify-content: center;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .beta-sub {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const betaBtn = document.querySelector('.btn-beta-cta[data-open-beta]');
    betaBtn?.addEventListener('click', () => {
      try {
        if (typeof gtag === 'function') {
          gtag('event', 'sign_up', { method: 'beta_waitlist' });
        }
      } catch (e) {
        // Silently fail if gtag is blocked by adblocker
      }
    });
  });
</script>
