---
import { Image } from 'astro:assets';
import betaLifestyle from '../assets/images/beta-lifestyle-edited.png';
---

<section class="beta-signup section" id="beta">
  <div class="container">
    <div class="beta-wrapper">
      <div class="beta-lifestyle-side animate-in">
        <Image src={betaLifestyle} alt="Frau in Yoga-Brückenpose in beiger Aktivkleidung" class="beta-lifestyle-img" loading="lazy" />
      </div>
      <div class="beta-card animate-in">
      <div class="beta-content">
        <div class="beta-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
            <path d="M12 16v-4"/>
            <path d="M12 8h.01"/>
          </svg>
        </div>
        <span class="beta-label" data-i18n="beta.label">Beta-Programm</span>
        <h2 class="beta-title" data-i18n="beta.title">
          Hilf uns, Fitness für Frauen zu revolutionieren
        </h2>
        <p class="beta-description" data-i18n="beta.description">
          Wir laden eine kleine Gruppe von Frauen ein, Diamo vor dem Launch zu testen. 
          Erhalte frühzeitigen Zugang, teile dein Feedback und hilf uns, etwas zu entwickeln, 
          das wirklich zu deinem Körper und deinem Leben passt.
        </p>
        <div class="beta-features">
          <div class="beta-feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span data-i18n="beta.feat1">Kostenloser Zugang während der Beta</span>
          </div>
          <div class="beta-feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span data-i18n="beta.feat2">Direkter Einfluss auf Features</span>
          </div>
          <div class="beta-feature">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span data-i18n="beta.feat3">Founding-Member-Vorteile zum Launch</span>
          </div>
        </div>
        <button type="button" class="btn btn-primary beta-cta" data-open-waitlist>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <span data-i18n="beta.cta">Frühzugang sichern</span>
        </button>
        <p class="beta-note" data-i18n="beta.note">Begrenzte Plätze · Keine Verpflichtung · Jederzeit kündbar</p>
      </div>
      </div>
    </div>
  </div>
</section>

<style>
  .beta-signup {
    background: linear-gradient(180deg, var(--white) 0%, var(--ivory) 100%);
    padding-top: var(--space-lg);
  }

  .beta-wrapper {
    display: grid;
    grid-template-columns: 2fr 3fr;
    max-width: 960px;
    margin: 0 auto;
    background: var(--white);
    border-radius: var(--radius-xl);
    border: 1px solid var(--divider);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .beta-lifestyle-side {
    overflow: hidden;
    min-height: 400px;
    position: relative;
  }

  .beta-lifestyle-side::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(0, 32, 96, 0.38) 0%,
      rgba(26, 58, 122, 0.25) 40%,
      rgba(0, 32, 96, 0.4) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .beta-lifestyle-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform var(--transition-slow);
    filter: saturate(0.8) brightness(1.08) contrast(1.05);
  }

  .beta-lifestyle-side:hover .beta-lifestyle-img {
    transform: scale(1.03);
  }

  .beta-card {
    text-align: center;
    padding: var(--space-xl) var(--space-lg);
    position: relative;
  }

  .beta-card::before {
    display: none;
  }

  .beta-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto var(--space-sm);
    background: rgba(0, 32, 96, 0.05);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
  }

  .beta-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--lavender);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-sm);
  }

  .beta-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.2;
    color: var(--navy);
    margin-bottom: var(--space-md);
  }

  .beta-description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .beta-features {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--space-lg);
  }

  .beta-feature {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .beta-feature svg {
    color: var(--sage);
    flex-shrink: 0;
  }

  .beta-cta {
    padding: 1rem 2.25rem;
    font-size: 1rem;
  }

  .beta-note {
    margin-top: var(--space-sm);
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .beta-wrapper {
      grid-template-columns: 1fr;
    }

    .beta-lifestyle-side {
      min-height: 280px;
    }

    .beta-card {
      padding: var(--space-xl) var(--space-md);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const betaBtn = document.querySelector('.beta-cta[data-open-waitlist]');
    betaBtn?.addEventListener('click', () => {
      try {
        if (typeof gtag === 'function') {
          gtag('event', 'sign_up', { method: 'beta_waitlist' });
        }
      } catch (e) {
        // Silently fail if gtag is blocked by adblocker
      }
    });
  });
</script>
