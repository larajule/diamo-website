---
---

<section class="founders section" id="team">
  <div class="container">
    <div class="founders-inner">
      <span class="section-label animate-in" data-i18n="founders.label">The Founders</span>
      <h2 class="animate-in" data-i18n="founders.title">
        Built by women<br/>who get it.
      </h2>
      <p class="founders-story animate-in" data-i18n="founders.story">
        We built diamo because we were tired of fitness apps that treated every day the same. We wanted something that understood that our energy, our schedules, and our bodies change — and that the best motivation comes from real people, not push notifications.
      </p>
      <div class="founders-names animate-in">
        <div class="founder-card">
          <span class="founder-name">Marie</span>
          <span class="founder-role" data-i18n="founders.marie.role">Co-Founder · Strategy & Community</span>
        </div>
        <div class="founder-card">
          <span class="founder-name">Lara</span>
          <span class="founder-role" data-i18n="founders.lara.role">Co-Founder · Product & Health</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founders {
    background: var(--white);
  }

  .founders-inner {
    max-width: 600px;
  }

  .founders-inner h2 {
    margin-bottom: var(--space-md);
  }

  .founders-story {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .founders-names {
    display: flex;
    gap: var(--space-lg);
  }

  .founder-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-md) var(--space-lg);
    background: var(--ivory);
    border-radius: var(--radius-md);
    border: 1px solid var(--divider);
    min-width: 200px;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .founder-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .founder-name {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--navy);
  }

  .founder-role {
    font-size: 0.82rem;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  @media (max-width: 600px) {
    .founders-names {
      flex-direction: column;
      gap: var(--space-sm);
    }
    .founder-card { min-width: auto; }
  }
</style>
