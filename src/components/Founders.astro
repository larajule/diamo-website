---
---

<section class="founders section" id="team">
  <div class="container">
    <div class="founders-layout">
      <div class="founders-photo animate-in">
        <img src="/images/marie-lara.jpg" alt="Marie and Lara, founders of diamo" loading="lazy" />
      </div>
      <div class="founders-text">
        <span class="section-label animate-in" data-i18n="founders.label">The Founders</span>
        <h2 class="animate-in" data-i18n="founders.title">
          Built by women<br/>who get it.
        </h2>
        <p class="founders-story animate-in" data-i18n="founders.story">
          We built diamo because no fitness app understood that our sleep, our energy, and our daily reality all belong together. We wanted a system that listens to how we actually feel — and a community that shows up in real life, not just on a feed.
        </p>
        <div class="founders-names animate-in">
          <div class="founder">
            <span class="founder-name">Marie</span>
            <span class="founder-role" data-i18n="founders.marie.role">Co-Founder & Product</span>
          </div>
          <div class="founder">
            <span class="founder-name">Lara</span>
            <span class="founder-role" data-i18n="founders.lara.role">Co-Founder & Strategy</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founders {
    background: var(--white);
  }

  .founders-layout {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .founders-photo {
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .founders-photo img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-xl);
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  .founders-text h2 {
    margin-bottom: var(--space-md);
  }

  .founders-story {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 460px;
    margin-bottom: var(--space-lg);
  }

  .founders-names {
    display: flex;
    gap: var(--space-xl);
  }

  .founder {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .founder-name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--navy);
  }

  .founder-role {
    font-size: 0.82rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .founders-layout {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .founders-photo {
      max-width: 400px;
      margin: 0 auto;
    }

    .founders-story {
      max-width: none;
      margin-left: auto;
      margin-right: auto;
    }

    .founders-names {
      justify-content: center;
    }
  }
</style>
