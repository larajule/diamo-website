---
---

<section class="community section" id="community">
  <div class="container">
    <div class="community-layout">
      <div class="community-text">
        <span class="section-label animate-in" data-i18n="community.label">Community</span>
        <h2 class="animate-in" data-i18n="community.title">
          Move on your terms.<br/>Together when you want.
        </h2>
        <p class="community-desc animate-in" data-i18n="community.desc">
          From solo workouts to local run clubs and shared experiences. Find movement that fits your life — and people who make you want to show up.
        </p>
      </div>

      <div class="community-features animate-in">
        <div class="community-feature">
          <div class="community-feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <div class="community-feature-text">
            <h4 data-i18n="community.events">Local events</h4>
            <p data-i18n="community.events.desc">Discover movement activities in your city</p>
          </div>
        </div>

        <div class="community-feature">
          <div class="community-feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="community-feature-text">
            <h4 data-i18n="community.groups">Run clubs</h4>
            <p data-i18n="community.groups.desc">Find women who run near you</p>
          </div>
        </div>

        <div class="community-feature">
          <div class="community-feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <div class="community-feature-text">
            <h4 data-i18n="community.connect">Real connections</h4>
            <p data-i18n="community.connect.desc">Off the screen, into real life</p>
          </div>
        </div>
      </div>
    </div>

    <div class="community-bottom animate-in">
      <a href="https://www.instagram.com/diamo.app" target="_blank" rel="noopener noreferrer" class="community-instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
        <span data-i18n="community.cta">Follow us on Instagram</span>
      </a>
      <span class="community-note" data-i18n="community.coming">Community features coming soon</span>
    </div>
  </div>
</section>

<style>
  .community {
    background: var(--ivory);
  }

  .community-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
    margin-bottom: var(--space-2xl);
  }

  .community-text h2 {
    margin-bottom: var(--space-md);
  }

  .community-desc {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 460px;
  }

  /* ─── Feature list ─── */
  .community-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .community-feature {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    padding: var(--space-md);
    background: var(--white);
    border-radius: var(--radius-md);
    border: 1px solid var(--divider);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .community-feature:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .community-feature-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--electric-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--electric);
  }

  .community-feature-text h4 {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.15rem;
  }

  .community-feature-text p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ─── Bottom link ─── */
  .community-bottom {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .community-instagram {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.5rem;
    background: var(--navy);
    color: var(--white);
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-weight: 600;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
    box-shadow: 0 4px 16px rgba(0, 32, 96, 0.2);
  }

  .community-instagram:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 32, 96, 0.3);
  }

  .community-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .community-layout {
      grid-template-columns: 1fr;
    }
    .community-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
