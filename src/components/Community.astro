---
---

<section class="community-section section" id="community">
  <div class="container">
    <div class="community-header animate-in">
      <span class="section-label" data-i18n="community.label">Die Community</span>
      <h2 class="section-title" data-i18n="community.title">
        Finde deine Girls statt digitaler Isolation
      </h2>
      <p class="community-description" data-i18n="community.description">
        Trainiere nicht mehr allein vor dem Screen. Wir nutzen digitale Daten, um echte, physische Begegnungen mit Girls direkt in deiner Stadt zu kuratieren.
      </p>
    </div>

    <div class="community-showcase animate-in">
      <div class="community-image-wrapper">
        <img
          src="/images/community-tribe.png"
          alt="Frauen trainieren gemeinsam in einer lokalen diamo Girls-Gruppe"
          class="community-hero-image"
          loading="lazy"
        />
        <div class="community-image-overlay"></div>
      </div>
      
      <div class="community-phone-float">
        <img
          src="/screenshots/community.png"
          alt="diamo Community App-Ansicht"
          class="community-mockup-img"
          loading="lazy"
        />
        <div class="community-glow"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .community-section {
    background: var(--ivory);
    overflow: hidden;
  }

  .community-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .community-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 600px;
    margin: var(--space-sm) auto 0;
  }

  /* Layered showcase: image as base, phone floating on top */
  .community-showcase {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .community-image-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .community-hero-image {
    width: 100%;
    height: 540px;
    object-fit: cover;
    object-position: center 55%;
    border-radius: var(--radius-xl);
    display: block;
    transition: transform var(--transition-slow);
  }

  .community-image-wrapper:hover .community-hero-image {
    transform: scale(1.02);
  }

  .community-image-overlay {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(135deg, transparent 50%, rgba(0, 32, 96, 0.12) 100%),
      linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.06) 100%);
    pointer-events: none;
  }

  /* Phone floating over the image */
  .community-phone-float {
    position: absolute;
    bottom: -40px;
    right: -20px;
    z-index: 3;
    animation: float 6s ease-in-out infinite;
  }

  /* Neues Flat-Mockup mit eigenem Phone-Frame */
  .community-mockup-img {
    width: 220px;
    height: auto;
    display: block;
    object-fit: contain;
    filter:
      drop-shadow(0 20px 50px rgba(0, 32, 96, 0.28))
      drop-shadow(0 4px 16px rgba(155, 139, 203, 0.15));
    transition: filter var(--transition-base);
  }

  .community-mockup-img:hover {
    filter:
      drop-shadow(0 28px 64px rgba(0, 32, 96, 0.35))
      drop-shadow(0 8px 24px rgba(155, 139, 203, 0.22));
  }

  .community-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(141, 198, 166, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    z-index: -1;
    filter: blur(40px);
  }

  @media (max-width: 768px) {
    .community-hero-image {
      height: auto;
    }

    .community-phone-float {
      right: 10px;
      bottom: -30px;
    }

    .community-mockup-img {
      width: 160px;
    }
  }

  @media (max-width: 480px) {
    .community-phone-float {
      right: 5px;
      bottom: -20px;
    }

    .community-mockup-img {
      width: 130px;
    }
  }
</style>
