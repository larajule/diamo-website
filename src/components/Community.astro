---
---

<section class="community-section section" id="community">
  <div class="container">
    <div class="community-grid">
      <div class="community-visual animate-in">
        <div class="phone-mockup">
          <div class="phone-frame">
            <img src="/screenshots/community.png" alt="Diamo Community App" class="phone-screen" />
          </div>
        </div>
        <div class="community-glow"></div>
      </div>
      
      <div class="community-text animate-in">
        <span class="section-label" data-i18n="community.label">Community</span>
        <h2 class="section-title" data-i18n="community.title">
          Find your tribe instead of digital isolation
        </h2>
        <p class="community-description" data-i18n="community.description">
          Don't train alone in front of a screen. We use digital data to curate real, physical encounters in local tribes directly in your city.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .community-section {
    background: var(--ivory);
    overflow: hidden;
  }

  .community-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .community-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .community-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  /* Phone Mockup */
  .community-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .phone-mockup {
    position: relative;
    z-index: 2;
    animation: float 6s ease-in-out infinite;
  }

  .phone-frame {
    position: relative;
    width: 280px;
    background: var(--soft-black);
    border-radius: 38px;
    padding: 10px;
    box-shadow: 
      0 16px 48px rgba(0, 32, 96, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
  }

  .phone-screen {
    width: 100%;
    border-radius: 30px;
    display: block;
  }

  .community-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(141, 198, 166, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    z-index: 1;
    filter: blur(40px);
  }

  @media (max-width: 768px) {
    .community-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-xl);
    }

    .community-visual {
      order: 1;
    }

    .community-description {
      margin: 0 auto;
    }

    .phone-frame {
      width: 220px;
    }
  }
</style>
