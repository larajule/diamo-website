---
import { Image } from 'astro:assets';
import communityTribe from '../assets/images/community-tribe.png';
import communityScreen from '../assets/screenshots/community.png';
---

<section class="community-section section" id="community">
  <div class="container">
    <div class="community-header animate-in">
      <span class="section-label" data-i18n="community.label">Die Community</span>
      <h2 class="section-title" data-i18n="community.title">
        Finde deine Girls statt digitaler Isolation
      </h2>
      <p class="community-description" data-i18n="community.description">
        Trainiere nicht mehr allein vor dem Screen. Wir nutzen digitale Daten, um echte, physische Begegnungen mit Girls direkt in deiner Stadt zu kuratieren.
      </p>
    </div>

    <div class="community-showcase animate-in">
      <div class="community-image-wrapper">
        <Image src={communityTribe} alt="Frauen trainieren gemeinsam in einer lokalen diamo Girls-Gruppe" class="community-hero-image" loading="lazy" />
        <div class="community-image-overlay"></div>
      </div>
      
      <div class="community-phone-float">
        <div class="phone-frame">
          <Image src={communityScreen} alt="diamo Community App-Ansicht" class="phone-screen" loading="lazy" />
        </div>
        <div class="community-glow"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .community-section {
    background: var(--ivory);
    overflow: hidden;
  }

  .community-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .community-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 600px;
    margin: var(--space-sm) auto 0;
  }

  /* Layered showcase: image as base, phone floating on top */
  .community-showcase {
    position: relative;
    max-width: 450px;
    margin: 0 auto;
  }

  .community-image-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .community-hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    display: block;
    transition: transform var(--transition-slow);
  }

  .community-image-wrapper:hover .community-hero-image {
    transform: scale(1.02);
  }

  .community-image-overlay {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(135deg, transparent 50%, rgba(0, 32, 96, 0.12) 100%),
      linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.06) 100%);
    pointer-events: none;
  }

  /* Phone floating over the image */
  .community-phone-float {
    position: absolute;
    bottom: -40px;
    right: -20px;
    z-index: 3;
    animation: float 6s ease-in-out infinite;
  }

  .phone-frame {
    position: relative;
    width: 220px;
    background: var(--soft-black);
    border-radius: 32px;
    padding: 8px;
    box-shadow: 
      0 20px 60px rgba(0, 32, 96, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset,
      0 0 80px rgba(155, 139, 203, 0.1);
  }

  .phone-screen {
    width: 100%;
    border-radius: 26px;
    display: block;
  }

  .community-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(141, 198, 166, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    z-index: -1;
    filter: blur(40px);
  }

  @media (max-width: 768px) {
    .community-hero-image {
      height: auto;
    }

    .community-phone-float {
      right: 10px;
      bottom: -30px;
    }

    .phone-frame {
      width: 160px;
      border-radius: 26px;
      padding: 6px;
    }

    .phone-screen {
      border-radius: 22px;
    }
  }

  @media (max-width: 480px) {
    .community-phone-float {
      right: 5px;
      bottom: -20px;
    }

    .phone-frame {
      width: 130px;
    }
  }
</style>
