---
---

<section class="community-section section" id="community">
  <div class="container">
    <div class="community-header animate-in">
      <span class="section-label" data-i18n="community.label">Community</span>
      <h2 class="section-title" data-i18n="community.title">
        Find your tribe instead of digital isolation
      </h2>
      <p class="community-description" data-i18n="community.description">
        Don't train alone in front of a screen. We use digital data to curate real, physical encounters in local tribes directly in your city.
      </p>
    </div>

    <div class="community-grid">
      <div class="community-visual animate-in">
        <div class="community-image-wrapper">
          <img src="/images/community-tribe.png" alt="Women exercising together in a local Diamo tribe" class="community-hero-image" />
          <div class="community-image-overlay"></div>
        </div>
      </div>

      <div class="community-phone animate-in">
        <div class="phone-mockup">
          <div class="phone-frame">
            <img src="/screenshots/community.png" alt="Diamo Community App" class="phone-screen" />
          </div>
        </div>
        <div class="community-glow"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .community-section {
    background: var(--ivory);
    overflow: hidden;
  }

  .community-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .community-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 600px;
    margin: var(--space-sm) auto 0;
  }

  .community-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-xl);
    align-items: center;
  }

  /* Lifestyle Image */
  .community-visual {
    position: relative;
  }

  .community-image-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .community-hero-image {
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    transition: transform var(--transition-slow);
  }

  .community-image-wrapper:hover .community-hero-image {
    transform: scale(1.03);
  }

  .community-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(0, 32, 96, 0.08) 100%);
    pointer-events: none;
  }

  /* Phone Mockup */
  .community-phone {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .phone-mockup {
    position: relative;
    z-index: 2;
    animation: float 6s ease-in-out infinite;
  }

  .phone-frame {
    position: relative;
    width: 260px;
    background: var(--soft-black);
    border-radius: 38px;
    padding: 10px;
    box-shadow: 
      0 16px 48px rgba(0, 32, 96, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
  }

  .phone-screen {
    width: 100%;
    border-radius: 30px;
    display: block;
  }

  .community-glow {
    position: absolute;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(141, 198, 166, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    z-index: 1;
    filter: blur(40px);
  }

  @media (max-width: 768px) {
    .community-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .community-hero-image {
      height: 280px;
    }

    .community-phone {
      order: 1;
    }

    .phone-frame {
      width: 220px;
    }
  }
</style>
