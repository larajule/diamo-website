---
---
<section class="club" id="club">
  <div class="club-bg" aria-hidden="true">
    <img src="/images/kyb-community-girls.jpg" alt="" class="club-bg-img" />
  </div>
  <div class="container">
    <div class="club-inner">
      <div class="club-left">
        <span class="club-label" data-i18n="club.label">MAKE A MOVE.</span>
        <h2 class="club-headline" data-i18n="club.headline">GOOD WALKS. BETTER COMPANY.</h2>
        <p class="club-sub" data-i18n="club.sub">First Sunday of every month. Cologne. Free.</p>

        <ul class="club-perks">
          <li>
            <span class="perk-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </span>
            <span data-i18n="club.perk1">First Sunday of every month</span>
          </li>
          <li>
            <span class="perk-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span data-i18n="club.perk2">11 AM · Cologne</span>
          </li>
          <li>
            <span class="perk-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <span data-i18n="club.perk3">SCAN TO JOIN.</span>
          </li>
        </ul>

        <div class="club-ctas">
          <a href="https://chat.whatsapp.com/HJWNFDztOniLsqaQhUKAwU" target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span data-i18n="club.cta.whatsapp">JOIN THE GROUP</span>
          </a>
          <button class="btn-whatsapp btn-beta" data-open-beta>
            <span data-i18n="club.cta.beta">JOIN THE BETA</span>
          </button>
        </div>
        <p class="club-disclaimer" data-i18n="club.card.disclaimer">Walk registration is separate from app beta access.</p>
      </div>

      <div class="club-right">
        <div class="receipt-card" id="receipt-card">
          <div class="receipt-inner">
            <!-- FRONT -->
            <div class="receipt-front">
              <div class="receipt-header">
                <span class="receipt-logo">d.</span>
                <span class="receipt-title">girls walking club</span>
              </div>
              <div class="receipt-divider">· · · · · · · · · · · · · · · · · · ·</div>
              <div class="receipt-meta">
                <div class="receipt-row"><span>LOCATION</span><span>Cologne</span></div>
                <div class="receipt-row"><span>MEMBER</span><span>nº 0047</span></div>
                <div class="receipt-row"><span>MEMBER SINCE</span><span>today</span></div>
              </div>
              <div class="receipt-divider">· · · · · · · · · · · · · · · · · · ·</div>
              <div class="receipt-items">
                <div class="receipt-item"><span>fresh air</span><span>1x</span></div>
                <div class="receipt-item"><span>gossip</span><span>unlimited</span></div>
                <div class="receipt-item"><span>new friends</span><span>likely</span></div>
                <div class="receipt-item"><span>excuses</span><span>0</span></div>
                <div class="receipt-item"><span>doomscrolling</span><span>-100%</span></div>
                <div class="receipt-item receipt-item--strike"><span>your ex</span><span>not invited</span></div>
              </div>
              <div class="receipt-divider">· · · · · · · · · · · · · · · · · · ·</div>
              <div class="receipt-total">
                <span>TOTAL</span><span>FREE</span>
              </div>
              <div class="receipt-footer">
                <p>make a move.</p>
                <p>see you there.</p>
                <p>xx, the girls</p>
              </div>
              <div class="receipt-flip-hint">↻ tap to flip</div>
            </div>

            <!-- BACK -->
            <div class="receipt-back">
              <div class="receipt-back-logo">d.</div>
              <p class="receipt-back-tagline">join us or miss us.</p>
              <div class="receipt-qr">
                <img src="/images/whatsapp-qr.png" alt="WhatsApp QR code — scan to join Girls Walking Club" width="130" height="130" />
              </div>
              <p class="receipt-qr-copy" data-i18n="club.qr.copy">only scan if you're one of the girls.</p>
              <div class="receipt-divider">· · · · · · · · · · · · · · · · · · ·</div>
              <div class="receipt-back-meta">
                <div class="receipt-row"><span>scan to redeem</span><span>✓</span></div>
                <div class="receipt-row"><span>valid</span><span>every walk</span></div>
                <div class="receipt-row"><span>expires</span><span>never</span></div>
                <div class="receipt-row"><span>plus ones</span><span>welcome</span></div>
              </div>
              <div class="receipt-divider">· · · · · · · · · · · · · · · · · · ·</div>
              <p class="receipt-back-fine">no refunds, just friends.</p>
              <p class="receipt-back-fine">girls walking club · cologne</p>
              <div class="receipt-flip-hint">↻ tap to flip</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .club {
    background: #F0F6FF;
    padding: 7rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .club-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .club-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.07;
    filter: saturate(0.3);
  }

  .club > .container {
    position: relative;
    z-index: 1;
  }

  .club-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
  }

  .club-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cobalt, #1535A8);
    margin-bottom: 1.25rem;
    display: block;
  }

  .club-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    color: var(--navy, #002060);
    letter-spacing: -0.02em;
    line-height: 1.0;
    margin-bottom: 1rem;
  }

  .club-sub {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: rgba(0,32,96,0.7);
    margin-bottom: 2rem;
  }

  .club-perks {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .club-perks li {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: rgba(0,32,96,0.8);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .perk-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--cobalt, #1535A8);
  }
  .perk-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    display: block;
  }

  .club-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.9rem 2rem;
    border-radius: 100px;
    background: var(--navy, #002060);
    color: #fff;
    text-decoration: none;
    transition: all 0.25s;
    width: fit-content;
    letter-spacing: 0.02em;
  }

  .btn-whatsapp:hover {
    background: var(--cobalt, #1535A8);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,32,96,0.25);
  }

  .btn-beta-outline {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.9rem 2rem;
    border-radius: 100px;
    border: none;
    background: var(--navy, #002060);
    color: #fff;
    cursor: pointer;
    transition: all 0.25s;
    width: fit-content;
    letter-spacing: 0.02em;
  }

  .btn-beta-outline:hover {
    background: var(--cobalt, #1535A8);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,32,96,0.25);
  }

  .club-disclaimer {
    font-size: 0.75rem;
    color: rgba(0,32,96,0.4);
    margin-top: 0.5rem;
  }

  /* ── Receipt Card ── */
  .receipt-card {
    perspective: 1000px;
    width: 300px;
    height: 520px;
    margin: 0 auto;
    cursor: pointer;
  }

  .receipt-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.4,0,0.2,1);
  }

  .receipt-card.flipped .receipt-inner {
    transform: rotateY(180deg);
  }

  .receipt-front, .receipt-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: #fff;
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.72rem;
    color: var(--navy, #002060);
    box-shadow: 0 20px 60px rgba(0,0,0,0.18), 0 4px 16px rgba(0,0,0,0.2);
    overflow-y: auto;
  }

  .receipt-back {
    transform: rotateY(180deg);
    text-align: center;
  }

  .receipt-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .receipt-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy, #002060);
    letter-spacing: -0.02em;
  }

  .receipt-title {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(0,32,96,0.6);
  }

  .receipt-divider {
    color: rgba(0,32,96,0.2);
    text-align: center;
    letter-spacing: 0.05em;
    overflow: hidden;
  }

  .receipt-meta, .receipt-items, .receipt-back-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .receipt-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .receipt-row span:first-child {
    color: rgba(0,32,96,0.55);
    text-transform: uppercase;
    font-size: 0.65rem;
  }

  .receipt-item {
    display: flex;
    justify-content: space-between;
  }

  .receipt-item--strike span {
    text-decoration: line-through;
    opacity: 0.5;
  }

  .receipt-total {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--navy, #002060);
  }

  .receipt-footer {
    text-align: center;
    color: rgba(0,32,96,0.6);
    font-size: 0.65rem;
    line-height: 1.8;
  }

  .receipt-flip-hint {
    text-align: center;
    font-size: 0.6rem;
    color: rgba(0,32,96,0.3);
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .receipt-back-logo {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--navy, #002060);
    letter-spacing: -0.02em;
  }

  .receipt-back-tagline {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(0,32,96,0.6);
  }

  .receipt-qr {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }

  .receipt-qr img {
    border-radius: 8px;
    display: block;
  }

  .receipt-qr-copy {
    font-size: 0.65rem;
    color: rgba(0,32,96,0.55);
    font-style: italic;
  }

  .receipt-back-fine {
    font-size: 0.6rem;
    color: rgba(0,32,96,0.4);
  }

  @media (max-width: 900px) {
    .club-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .receipt-card {
      width: 260px;
      height: 480px;
    }
  }

  @media (max-width: 768px) {
    .club { padding: 5rem 1.5rem; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var card = document.getElementById('receipt-card');
    if (card) {
      card.addEventListener('click', function() {
        card.classList.toggle('flipped');
      });
    }
  });
</script>
