---
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "diamo | Workouts, die sich dir anpassen",
  description = "Jeden Tag ein Workout, das zu deinem Körper passt. Smart, persönlich, gemeinsam. Jetzt Early Access sichern.",
  keywords = "personalisiertes Training, Fitness App Frauen, Smart Workouts, Body Intelligence, Frauen Community",
  ogTitle = "diamo | Smart workouts that adapt to your body",
  ogDescription = "A workout that understands how you feel today. Smart, personal, together. Get early access now.",
  ogImage = "https://diamo.club/diamo-preview.jpg",
  canonicalUrl
} = Astro.props;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />

<!-- Canonical URL -->
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

<!-- Open Graph -->
<meta property="og:title" content={ogTitle || title} />
<meta property="og:description" content={ogDescription || description} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content="diamo" />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle || title} />
<meta name="twitter:description" content={ogDescription || description} />
<meta name="twitter:image" content={ogImage} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "diamo",
  "url": "https://diamo.club",
  "logo": "https://diamo.club/icon.png",
  "description": "Zyklusbasiertes, personalisiertes Fitness-Training für Frauen. Workouts im Einklang mit deiner Biologie und einer echten, lokalen Community.",
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "hello@diamo.club",
    "contactType": "customer service"
  },
  "sameAs": []
})} />

<!-- JSON-LD SoftwareApplication -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "diamo",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "iOS, Android",
  "description": "Zyklusbasiertes, personalisiertes Fitness-Training für Frauen. Workouts im Einklang mit deiner Biologie und einer echten, lokalen Community.",
  "url": "https://diamo.club",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR"
  }
})} />
