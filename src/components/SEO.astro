---
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalUrl?: string;
  hreflangDe?: string;
  hreflangEn?: string;
}

const {
  title = "diamo | Female Health, Longevity & Personalized Movement",
  description = "Meet diamo. A female health and longevity platform connecting personalized movement, body intelligence and real-life community. Join the club.",
  keywords = "female health, longevity, personalized training, women fitness, female community Cologne, Frauengesundheit, personalisiertes Training",
  ogTitle = "diamo | Female Health, Longevity & Personalized Movement",
  ogDescription = "Meet diamo. A female health and longevity platform connecting personalized movement, body intelligence and real-life community. Join the club.",
  ogImage = "https://diamo.club/images/diamo-og.jpg",
  canonicalUrl,
  hreflangDe,
  hreflangEn
} = Astro.props;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />

<!-- Canonical URL -->
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{hreflangDe && hreflangEn && (
  <>
    <link rel="alternate" hreflang="de" href={hreflangDe} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="x-default" href={hreflangDe} />
  </>
)}

<!-- Open Graph -->
<meta property="og:title" content={ogTitle || title} />
<meta property="og:description" content={ogDescription || description} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content="diamo" />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle || title} />
<meta name="twitter:description" content={ogDescription || description} />
<meta name="twitter:image" content={ogImage} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "diamo",
  "url": "https://diamo.club",
  "logo": "https://diamo.club/images/diamo-og.jpg",
  "description": "diamo is a Female Health & Longevity Platform. Personalized movement, body knowledge and real-life community — built for women.",
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "hello@diamo.club",
    "contactType": "customer service"
  },
  "sameAs": []
})} />

<!-- JSON-LD SoftwareApplication -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "diamo",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "iOS, Android",
  "description": "diamo is a Female Health & Longevity Platform. Personalized movement, body knowledge and real-life community — built for women.",
  "url": "https://diamo.club",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR"
  }
})} />
