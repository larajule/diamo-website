---
---

<section class="cta-section" id="beta">
  <div class="cta-dark">
    <div class="cta-bg-accent"></div>
    <div class="container">
      <div class="cta-content animate-in">
        <span class="section-label section-label--light" data-i18n="cta.label">Early Access</span>
        <h2 class="cta-headline" data-i18n="cta.title">
          Your next move<br/>starts here.
        </h2>
        <p class="cta-desc" data-i18n="cta.desc">
          diamo is currently in development. Join Early Access to be among the first to try it, give feedback, and help shape what comes next.
        </p>
        <div class="cta-actions">
          <button type="button" class="btn btn-light" data-open-beta>
            <span data-i18n="cta.button">Join Early Access</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <span class="cta-note" data-i18n="cta.note">Free to join. No commitment.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section { padding: 0; }

  .cta-dark {
    background: var(--navy-deep);
    padding: var(--space-3xl) 0;
    position: relative;
    overflow: hidden;
  }

  .cta-bg-accent {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 70% at 75% 30%, rgba(44, 122, 255, 0.07) 0%, transparent 55%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 520px;
    text-align: center;
    margin: 0 auto;
  }

  .cta-headline {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.12;
    color: var(--white);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
  }

  .cta-desc {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.7;
    color: var(--text-inverse-muted);
    margin-bottom: var(--space-lg);
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .cta-note {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .cta-dark { padding: var(--space-2xl) 0; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ctaBtn = document.querySelector('.cta-section .btn[data-open-beta]');
    ctaBtn?.addEventListener('click', () => {
      try {
        if (typeof gtag === 'function') {
          gtag('event', 'sign_up', { method: 'early_access_cta' });
        }
      } catch (e) { /* silently fail */ }
    });
  });
</script>
