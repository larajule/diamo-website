---
const steps = [
  {
    number: '01',
    title: 'Tell us about you',
    description: 'A quick onboarding captures your fitness goals, cycle data, energy patterns, and personal preferences to create your unique persona.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`
  },
  {
    number: '02',
    title: 'Get your daily plan',
    description: 'Every morning, Diamo delivers a personalized workout adapted to your cycle phase, energy level, and how you slept — all powered by real science.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`
  },
  {
    number: '03',
    title: 'Move with your tribe',
    description: 'Join local events, share your journey, and connect with women who train in sync with their bodies. Away from the screen, into real life.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>`
  }
];
---

<section class="how-it-works section" id="how-it-works">
  <div class="container">
    <div class="hiw-header">
      <span class="section-label animate-in">How It Works</span>
      <h2 class="section-title animate-in">
        Three steps to training<br/>in harmony with your body.
      </h2>
    </div>
    
    <div class="hiw-steps">
      {steps.map((step, i) => (
        <div class="hiw-step animate-in" style={`transition-delay: ${0.1 + i * 0.15}s`}>
          <div class="hiw-step-number">{step.number}</div>
          <div class="hiw-step-icon">
            <Fragment set:html={step.icon} />
          </div>
          <h3 class="hiw-step-title">{step.title}</h3>
          <p class="hiw-step-description">{step.description}</p>
          {i < steps.length - 1 && (
            <div class="hiw-connector">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--divider)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-it-works {
    background: linear-gradient(180deg, var(--ivory) 0%, var(--white) 100%);
  }

  .hiw-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .hiw-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
    position: relative;
  }

  .hiw-step {
    text-align: center;
    position: relative;
  }

  .hiw-step-number {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    font-weight: 700;
    color: rgba(0, 32, 96, 0.06);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  .hiw-step-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 32, 96, 0.04);
    border-radius: var(--radius-lg);
    color: var(--navy);
    transition: all var(--transition-base);
  }

  .hiw-step:hover .hiw-step-icon {
    background: rgba(0, 32, 96, 0.08);
    transform: scale(1.05);
  }

  .hiw-step-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: var(--space-xs);
  }

  .hiw-step-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 300px;
    margin: 0 auto;
  }

  .hiw-connector {
    display: none;
    position: absolute;
    right: -30px;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (min-width: 769px) {
    .hiw-connector {
      display: block;
    }
  }

  @media (max-width: 768px) {
    .hiw-steps {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
