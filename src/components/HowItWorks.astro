---
---

<section class="how-it-works section" id="how-it-works">
  <div class="container">
    <div class="hiw-header">
      <span class="section-label animate-in" data-i18n="hiw.label">How It Works</span>
      <h2 class="section-title animate-in" data-i18n="hiw.title">
        Three steps to training<br/>in harmony with your body
      </h2>
    </div>
    
    <div class="hiw-steps">
      <div class="hiw-step animate-in" style="transition-delay: 0.1s">
        <div class="hiw-step-number">01</div>
        <div class="hiw-step-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <h3 class="hiw-step-title" data-i18n="hiw.s1.title">Tell us about you</h3>
        <p class="hiw-step-description" data-i18n="hiw.s1.desc">A quick onboarding captures your fitness goals, cycle data, energy patterns, and personal preferences to create your unique persona.</p>
        <div class="hiw-connector">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--divider)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
      </div>

      <div class="hiw-step animate-in" style="transition-delay: 0.25s">
        <div class="hiw-step-number">02</div>
        <div class="hiw-step-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3 class="hiw-step-title" data-i18n="hiw.s2.title">Get your daily plan</h3>
        <p class="hiw-step-description" data-i18n="hiw.s2.desc">Every morning, Diamo delivers a personalized workout adapted to your cycle phase, energy level, and how you slept. All powered by real science.</p>
        <div class="hiw-connector">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--divider)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
      </div>

      <div class="hiw-step animate-in" style="transition-delay: 0.4s">
        <div class="hiw-step-number">03</div>
        <div class="hiw-step-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
        </div>
        <h3 class="hiw-step-title" data-i18n="hiw.s3.title">Move with your tribe</h3>
        <p class="hiw-step-description" data-i18n="hiw.s3.desc">Join local events, share your journey, and connect with women who train in sync with their bodies. Away from the screen, into real life.</p>
      </div>
    </div>

    <div class="hiw-lifestyle-accent animate-in">
      <img src="/images/hiw-lifestyle.jpeg" alt="Fitness lifestyle" class="hiw-lifestyle-img" />
      <div class="hiw-lifestyle-overlay"></div>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    background: linear-gradient(180deg, var(--ivory) 0%, var(--white) 100%);
  }

  .hiw-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .hiw-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
    position: relative;
  }

  .hiw-step {
    text-align: center;
    position: relative;
  }

  .hiw-step-number {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    font-weight: 700;
    color: rgba(0, 32, 96, 0.06);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  .hiw-step-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 32, 96, 0.04);
    border-radius: var(--radius-lg);
    color: var(--navy);
    transition: all var(--transition-base);
  }

  .hiw-step:hover .hiw-step-icon {
    background: rgba(0, 32, 96, 0.08);
    transform: scale(1.05);
  }

  .hiw-step-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: var(--space-xs);
  }

  .hiw-step-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 300px;
    margin: 0 auto;
  }

  .hiw-connector {
    display: none;
    position: absolute;
    right: -30px;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (min-width: 769px) {
    .hiw-connector {
      display: block;
    }
  }

  .hiw-lifestyle-accent {
    margin-top: var(--space-2xl);
    border-radius: var(--radius-xl);
    overflow: hidden;
    height: 200px;
    position: relative;
    box-shadow: var(--shadow-md);
  }

  .hiw-lifestyle-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
    transition: transform var(--transition-slow);
  }

  .hiw-lifestyle-accent:hover .hiw-lifestyle-img {
    transform: scale(1.02);
  }

  .hiw-lifestyle-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgba(0, 32, 96, 0.06) 100%);
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .hiw-steps {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
