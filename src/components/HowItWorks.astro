---
---

<section class="how-it-works section" id="how-it-works">
  <div class="container">
    <div class="hiw-header">
      <span class="section-label animate-in" data-i18n="hiw.label">So funktioniert's</span>
      <h2 class="section-title animate-in" data-i18n="hiw.title">
        Three steps.<br/>One system.
      </h2>
    </div>

    <!-- Step 1: Check In — the daily ritual -->
    <div class="hiw-row" data-hiw-step>
      <div class="hiw-text">
        <div class="hiw-num">01</div>
        <h3 class="hiw-step-title" data-i18n="hiw.s1.title">Check in</h3>
        <p class="hiw-step-desc" data-i18n="hiw.s1.desc">30 seconds each morning. How did you sleep? How do you feel? Your body signals guide the day.</p>
      </div>
      <div class="hiw-visual">
        <div class="hiw-duo">
          <div class="hiw-duo-card hiw-duo-card--back">
            <img src="/screenshots/onboarding-2.png" alt="diamo Onboarding" loading="lazy" />
          </div>
          <div class="hiw-duo-card hiw-duo-card--front">
            <img src="/screenshots/onboarding-1.png" alt="diamo Check-In" loading="lazy" />
          </div>
        </div>
      </div>
    </div>

    <!-- Step 2: Your plan adapts -->
    <div class="hiw-row hiw-row--reverse" data-hiw-step>
      <div class="hiw-text">
        <div class="hiw-num">02</div>
        <h3 class="hiw-step-title" data-i18n="hiw.s2.title">Your plan adapts</h3>
        <p class="hiw-step-desc" data-i18n="hiw.s2.desc">Strength, mobility, or recovery. diamo builds today's workout from your sleep, energy, and readiness. Every day is different.</p>
      </div>
      <div class="hiw-visual">
        <div class="hiw-duo">
          <div class="hiw-duo-card hiw-duo-card--back">
            <img src="/screenshots/home-insights.png" alt="diamo Insights" loading="lazy" />
          </div>
          <div class="hiw-duo-card hiw-duo-card--front">
            <img src="/screenshots/calendar-weekly.png" alt="diamo Calendar" loading="lazy" />
          </div>
        </div>
      </div>
    </div>

    <!-- Step 3: Move together -->
    <div class="hiw-row" data-hiw-step>
      <div class="hiw-text">
        <div class="hiw-num">03</div>
        <h3 class="hiw-step-title" data-i18n="hiw.s3.title">Move together</h3>
        <p class="hiw-step-desc" data-i18n="hiw.s3.desc">Train solo or find women in your city. Events, challenges, and real connections. Off the screen, into real life.</p>
      </div>
      <div class="hiw-visual">
        <div class="hiw-duo">
          <div class="hiw-duo-card hiw-duo-card--back">
            <img src="/screenshots/home-training.png" alt="diamo Community" loading="lazy" />
          </div>
          <div class="hiw-duo-card hiw-duo-card--front">
            <img src="/screenshots/home-workout.png" alt="diamo Workout" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    background: linear-gradient(180deg, var(--ivory) 0%, var(--white) 100%);
  }

  .hiw-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .hiw-row {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    margin-bottom: var(--space-3xl);
    opacity: 0.35;
    transform: scale(0.97);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .hiw-row:last-child { margin-bottom: 0; }

  .hiw-row.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .hiw-row--reverse { flex-direction: row-reverse; }

  .hiw-text { flex: 1; }
  .hiw-visual { flex: 0 0 auto; }

  .hiw-num {
    font-family: var(--font-serif);
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 700;
    line-height: 0.85;
    background: linear-gradient(135deg, var(--navy) 0%, var(--lavender) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.15;
    margin-bottom: var(--space-sm);
  }
  .hiw-row.is-active .hiw-num { opacity: 0.25; }

  .hiw-step-title {
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 2vw, 1.4rem);
    font-weight: 700;
    color: var(--navy);
    margin-bottom: var(--space-xs);
  }

  .hiw-step-desc {
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 420px;
  }

  /* ─── Single phone screen (no frame) ─── */
  .hiw-phone-screen {
    width: clamp(220px, 24vw, 280px);
    border-radius: clamp(28px, 4vw, 44px);
    overflow: hidden;
    box-shadow:
      0 4px 12px rgba(0, 20, 60, 0.06),
      0 16px 48px rgba(0, 20, 60, 0.10),
      0 32px 80px rgba(0, 20, 60, 0.08);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }
  .hiw-row.is-active .hiw-phone-screen {
    transform: translateY(-6px);
    box-shadow: 0 8px 20px rgba(0, 20, 60, 0.08), 0 24px 64px rgba(0, 20, 60, 0.12);
  }
  .hiw-phone-screen img { width: 100%; height: auto; display: block; }

  /* ─── Duo layout ─── */
  .hiw-duo {
    position: relative;
    width: clamp(260px, 28vw, 340px);
  }

  .hiw-duo-card {
    border-radius: clamp(28px, 4vw, 44px);
    overflow: hidden;
    box-shadow:
      0 4px 12px rgba(0, 20, 60, 0.06),
      0 16px 48px rgba(0, 20, 60, 0.10);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hiw-duo-card img { width: 100%; height: auto; display: block; }

  .hiw-duo-card--front {
    position: relative;
    z-index: 2;
    width: 85%;
  }
  .hiw-duo-card--back {
    position: absolute;
    top: 20px; right: 0;
    z-index: 1;
    width: 85%;
    opacity: 0.8;
  }

  .hiw-row.is-active .hiw-duo-card--front {
    transform: translateY(-4px);
  }
  .hiw-row.is-active .hiw-duo-card--back {
    transform: translate(4px, 24px);
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .hiw-row, .hiw-row--reverse {
      flex-direction: column;
      text-align: center;
      gap: var(--space-lg);
    }
    .hiw-step-desc { max-width: none; margin: 0 auto; }
    .hiw-duo { width: 280px; }
    .hiw-row { margin-bottom: var(--space-2xl); }
  }
</style>

<script>
  function updateActiveHiw() {
    const steps = document.querySelectorAll('[data-hiw-step]');
    if (!steps.length) return;
    const viewCenter = window.innerHeight / 2;
    let closest = null, closestDist = Infinity;
    steps.forEach(step => {
      const rect = step.getBoundingClientRect();
      const dist = Math.abs(rect.top + rect.height / 2 - viewCenter);
      if (dist < closestDist) { closestDist = dist; closest = step; }
    });
    steps.forEach(step => step.classList.toggle('is-active', step === closest));
  }
  window.addEventListener('scroll', updateActiveHiw, { passive: true });
  window.addEventListener('resize', updateActiveHiw);
  setTimeout(updateActiveHiw, 100);
</script>
