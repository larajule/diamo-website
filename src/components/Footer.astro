---
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-logo">d.</span>
        <p class="footer-tagline" data-i18n="footer.tagline">A New Era of<br/>Women's Health</p>
      </div>
      
      <div class="footer-links">
        <div class="footer-column">
          <h4 data-i18n="footer.product">Product</h4>
          <a href="#features" data-i18n="footer.product.features">Features</a>
          <a href="#how-it-works" data-i18n="footer.product.how">How It Works</a>
          <a href="#screenshots" data-i18n="footer.product.app">The App</a>
        </div>
        
        <div class="footer-column">
          <h4 data-i18n="footer.company">Company</h4>
          <a href="#team" data-i18n="footer.company.team">Team</a>
          <a href="#team" data-i18n="footer.company.careers">Careers</a>
        </div>
        
        <div class="footer-column">
          <h4 data-i18n="footer.contact">Get in Touch</h4>
          <a href="mailto:hello@diamo.club">hello@diamo.club</a>
        </div>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p class="footer-legal" data-i18n="footer.legal">© 2026 Diamo. All rights reserved.</p>
      <div class="footer-bottom-links">
        <a href="/datenschutz" data-i18n="footer.privacy">Privacy Policy</a>
        <a href="/agb" data-i18n="footer.terms">Terms of Service</a>
        <a href="/impressum" data-i18n="footer.imprint">Imprint</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--soft-black);
    color: rgba(255, 255, 255, 0.7);
    padding: var(--space-2xl) 0 var(--space-lg);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--white);
    line-height: 1;
  }

  .footer-tagline {
    margin-top: var(--space-sm);
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .footer-column h4 {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--white);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .footer-column a {
    display: block;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
    padding: 0.3rem 0;
    transition: color var(--transition-fast);
  }

  .footer-column a:hover {
    color: var(--white);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-md);
  }

  .footer-legal {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .footer-bottom-links {
    display: flex;
    gap: var(--space-md);
  }

  .footer-bottom-links a {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.3);
    transition: color var(--transition-fast);
  }

  .footer-bottom-links a:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
    }

    .footer-links {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .footer-bottom {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
