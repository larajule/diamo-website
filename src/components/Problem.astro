---

<section class="problem section" id="problem">
  <div class="container">

    <div class="problem-header">
      <span class="section-label animate-in" data-i18n="problem.label">Der Unterschied</span>
      <h2 class="section-title animate-in" data-i18n="problem.title">
        Standard-Fitness übersieht,<br/>was dich ausmacht.
      </h2>
    </div>

    <div class="problem-statements">
      <div class="problem-statement" data-problem-step>
        <div class="problem-num">01</div>
        <div class="problem-body">
          <p class="problem-text" data-i18n="problem.s1">
            Dein Körper folgt einem eigenen Rhythmus. Deine Energie, Kraft und Regeneration verändern sich jeden Tag. Die meisten Apps ignorieren das komplett.
          </p>
        </div>
      </div>

      <div class="problem-statement" data-problem-step>
        <div class="problem-num">02</div>
        <div class="problem-body">
          <p class="problem-text" data-i18n="problem.s2">
            diamo liest deine Zyklusdaten, Schlaf, Stress und Aktivität und baut daraus ein Workout, das genau zu dir passt. Jeden einzelnen Tag.
          </p>
        </div>
      </div>

      <div class="problem-statement" data-problem-step>
        <div class="problem-num">03</div>
        <div class="problem-body">
          <p class="problem-text" data-i18n="problem.s3">
            Keine teure Hardware nötig. Keine 08/15-Pläne. Ein System, das wirklich versteht, wie Frauenkörper funktionieren.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>


<style>
  .problem {
    position: relative;
  }

  .problem-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--space-2xl);
  }

  .problem-statements {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 800px;
    margin: 0 auto;
  }

  .problem-statement {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(0, 32, 96, 0.04);
    opacity: 0.45;
    transform: scale(0.98);
    transition: opacity 0.5s ease, transform 0.5s ease, background 0.5s ease, box-shadow 0.5s ease;
  }

  .problem-statement.is-active {
    opacity: 1;
    transform: scale(1);
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 8px 40px rgba(0, 32, 96, 0.07), 0 2px 12px rgba(155, 139, 203, 0.06);
    border-color: rgba(185, 215, 234, 0.4);
  }

  .problem-num {
    font-family: var(--font-serif);
    font-size: clamp(5rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 0.85;
    background: linear-gradient(135deg, var(--navy) 0%, var(--lavender) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.12;
    min-width: clamp(80px, 12vw, 130px);
    text-align: center;
    transition: opacity 0.5s ease;
    flex-shrink: 0;
  }

  .problem-statement.is-active .problem-num {
    opacity: 0.25;
  }

  .problem-body {
    flex: 1;
    padding-top: 0.75rem;
  }

  .problem-text {
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    line-height: 1.75;
    color: var(--text-primary);
    max-width: 500px;
  }

  @media (max-width: 768px) {
    .problem-header {
      text-align: left;
    }

    .problem-statement {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-sm);
      padding: var(--space-lg) var(--space-md);
    }

    .problem-num {
      font-size: 4rem;
      min-width: auto;
    }

    .problem-text {
      max-width: none;
    }
  }
</style>

<script>
  // Scroll-based highlight for problem statements
  function updateActiveProblem() {
    const steps = document.querySelectorAll('[data-problem-step]');
    if (!steps.length) return;

    const viewCenter = window.innerHeight / 2;
    let closestStep = null;
    let closestDist = Infinity;

    steps.forEach(step => {
      const rect = step.getBoundingClientRect();
      const stepCenter = rect.top + rect.height / 2;
      const dist = Math.abs(stepCenter - viewCenter);
      if (dist < closestDist) {
        closestDist = dist;
        closestStep = step;
      }
    });

    steps.forEach(step => {
      step.classList.toggle('is-active', step === closestStep);
    });
  }

  window.addEventListener('scroll', updateActiveProblem, { passive: true });
  window.addEventListener('resize', updateActiveProblem);
  setTimeout(updateActiveProblem, 100);
</script>
