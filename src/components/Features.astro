---
---

<section class="features section" id="features">
  <div class="container">
    <div class="features-header">
      <span class="section-label animate-in" data-i18n="features.label">Features</span>
      <h2 class="section-title animate-in" data-i18n="features.title">
        Your data, finally put to work
      </h2>
      <p class="section-subtitle animate-in" data-i18n="features.subtitle">
        Millions track with Apple Watch, Oura, or Garmin but nobody uses the data. Diamo reads your health data through the lens of your cycle phase and turns it into real, actionable workouts. No wearable? No problem, it works without one too.
      </p>
    </div>
    
    <div class="features-grid">
      <div class="features-lifestyle-banner animate-in">
        <img src="/images/features-lifestyle.jpeg" alt="Woman with foam roller, preparing for recovery" class="features-lifestyle-img" />
        <div class="features-lifestyle-overlay"></div>
        <span class="features-lifestyle-caption" data-i18n="features.lifestyle.caption">Recovery is part of the plan</span>
      </div>
      <div class="feature-card card animate-in" style="transition-delay: 0.1s">
        <div class="feature-icon" style="background: rgba(0, 32, 96, 0.06); color: var(--navy)">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2V6.5z"/><path d="M13.5 6.5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2V6.5z"/><path d="M3 10.5h3.5"/><path d="M3 13.5h3.5"/><path d="M17.5 10.5H21"/><path d="M17.5 13.5H21"/><path d="M10.5 12h3"/></svg>
        </div>
        <h3 class="feature-title" data-i18n="features.f1.title">Personalized Workouts</h3>
        <p class="feature-description" data-i18n="features.f1.desc">AI powered training plans that adapt daily based on your cycle phase, energy level, stress, and sleep quality.</p>
        <div class="feature-tags">
          <span class="feature-tag" style="border-color: rgba(0, 32, 96, 0.06)" data-i18n="features.f1.t1">Strength</span>
          <span class="feature-tag" style="border-color: rgba(0, 32, 96, 0.06)" data-i18n="features.f1.t2">Endurance</span>
          <span class="feature-tag" style="border-color: rgba(0, 32, 96, 0.06)" data-i18n="features.f1.t3">Mobility</span>
          <span class="feature-tag" style="border-color: rgba(0, 32, 96, 0.06)" data-i18n="features.f1.t4">Recovery</span>
        </div>
      </div>

      <div class="feature-card card animate-in" style="transition-delay: 0.2s">
        <div class="feature-icon" style="background: rgba(155, 139, 203, 0.08); color: var(--lavender)">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>
        </div>
        <h3 class="feature-title" data-i18n="features.f2.title">Cycle Synced Calendar</h3>
        <p class="feature-description" data-i18n="features.f2.desc">Understand your current cycle phase and its impact on energy, mood, and performance. Includes a daily adapted workout plan.</p>
        <div class="feature-tags">
          <span class="feature-tag" style="border-color: rgba(155, 139, 203, 0.08)" data-i18n="features.f2.t1">Phase Tracking</span>
          <span class="feature-tag" style="border-color: rgba(155, 139, 203, 0.08)" data-i18n="features.f2.t2">Energy Insights</span>
          <span class="feature-tag" style="border-color: rgba(155, 139, 203, 0.08)" data-i18n="features.f2.t3">Daily Plan</span>
          <span class="feature-tag" style="border-color: rgba(155, 139, 203, 0.08)" data-i18n="features.f2.t4">Wearable Sync</span>
        </div>
      </div>

      <div class="feature-card card animate-in" style="transition-delay: 0.3s">
        <div class="feature-icon" style="background: rgba(141, 198, 166, 0.1); color: var(--sage)">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="feature-title" data-i18n="features.f3.title">Community & Events</h3>
        <p class="feature-description" data-i18n="features.f3.desc">Connect with local run clubs, studios, and like-minded women. Personalized sport events based on your location and cycle.</p>
        <div class="feature-tags">
          <span class="feature-tag" style="border-color: rgba(141, 198, 166, 0.1)" data-i18n="features.f3.t1">Local Events</span>
          <span class="feature-tag" style="border-color: rgba(141, 198, 166, 0.1)" data-i18n="features.f3.t2">Run Clubs</span>
          <span class="feature-tag" style="border-color: rgba(141, 198, 166, 0.1)" data-i18n="features.f3.t3">Stories</span>
          <span class="feature-tag" style="border-color: rgba(141, 198, 166, 0.1)" data-i18n="features.f3.t4">Challenges</span>
        </div>
      </div>

      <div class="feature-card card animate-in" style="transition-delay: 0.4s">
        <div class="feature-icon" style="background: rgba(185, 215, 234, 0.15); color: var(--soft-blue)">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <h3 class="feature-title" data-i18n="features.f4.title">Smart Tracking</h3>
        <p class="feature-description" data-i18n="features.f4.desc">Seamless integration with Apple Health and wearables. Track steps, movement, and energy. The app works fully without hardware too.</p>
        <div class="feature-tags">
          <span class="feature-tag" style="border-color: rgba(185, 215, 234, 0.15)" data-i18n="features.f4.t1">Apple Health</span>
          <span class="feature-tag" style="border-color: rgba(185, 215, 234, 0.15)" data-i18n="features.f4.t2">Garmin</span>
          <span class="feature-tag" style="border-color: rgba(185, 215, 234, 0.15)" data-i18n="features.f4.t3">Whoop</span>
          <span class="feature-tag" style="border-color: rgba(185, 215, 234, 0.15)" data-i18n="features.f4.t4">Manual Input</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .features-header .section-subtitle {
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .features-lifestyle-banner {
    grid-column: 1 / -1;
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    height: 280px;
    box-shadow: var(--shadow-lg);
  }

  .features-lifestyle-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    display: block;
    transition: transform var(--transition-slow);
  }

  .features-lifestyle-banner:hover .features-lifestyle-img {
    transform: scale(1.02);
  }

  .features-lifestyle-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(0, 20, 60, 0.35) 100%);
    pointer-events: none;
  }

  .features-lifestyle-caption {
    position: absolute;
    bottom: var(--space-md);
    left: var(--space-lg);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--white);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-shadow: 0 1px 8px rgba(0,0,0,0.4);
  }

  .feature-card {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-xs);
  }

  .feature-title {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy);
  }

  .feature-description {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    flex-grow: 1;
  }

  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-xs);
  }

  .feature-tag {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--divider);
    color: var(--text-secondary);
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
