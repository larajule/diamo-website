---
const features = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`,
    title: 'Personalized Workouts',
    description: 'AI-powered training plans that adapt daily based on your cycle phase, energy level, stress, and sleep quality.',
    color: 'var(--navy)',
    bgColor: 'rgba(0, 32, 96, 0.06)',
    modules: ['Strength', 'Endurance', 'Mobility', 'Recovery']
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>`,
    title: 'Cycle-Synced Calendar',
    description: 'Understand your current cycle phase and its impact on energy, mood, and performance — with a daily adapted workout plan.',
    color: 'var(--lavender)',
    bgColor: 'rgba(155, 139, 203, 0.08)',
    modules: ['Phase Tracking', 'Energy Insights', 'Daily Plan', 'Wearable Sync']
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Community & Events',
    description: 'Connect with local run clubs, studios, and like-minded women. Personalized sport events based on your location and cycle.',
    color: 'var(--sage)',
    bgColor: 'rgba(141, 198, 166, 0.1)',
    modules: ['Local Events', 'Run Clubs', 'Stories', 'Challenges']
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    title: 'Smart Tracking',
    description: 'Seamless integration with Apple Health and wearables. Track steps, movement, and energy — the app works fully without hardware too.',
    color: 'var(--soft-blue)',
    bgColor: 'rgba(185, 215, 234, 0.15)',
    modules: ['Apple Health', 'Garmin', 'Whoop', 'Manual Input']
  }
];
---

<section class="features section" id="features">
  <div class="container">
    <div class="features-header">
      <span class="section-label animate-in">Features</span>
      <h2 class="section-title animate-in">
        Everything your body<br/>has been asking for.
      </h2>
      <p class="section-subtitle animate-in">
        Diamo combines cycle science, adaptive training, and real community 
        into one beautifully designed experience.
      </p>
    </div>
    
    <div class="features-grid">
      {features.map((feature, i) => (
        <div class="feature-card card animate-in" style={`transition-delay: ${0.1 + i * 0.1}s`}>
          <div class="feature-icon" style={`background: ${feature.bgColor}; color: ${feature.color}`}>
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-description">{feature.description}</p>
          <div class="feature-tags">
            {feature.modules.map(mod => (
              <span class="feature-tag" style={`border-color: ${feature.bgColor}`}>{mod}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .features-header .section-subtitle {
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .feature-card {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-xs);
  }

  .feature-title {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy);
  }

  .feature-description {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    flex-grow: 1;
  }

  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-xs);
  }

  .feature-tag {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--divider);
    color: var(--text-secondary);
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
