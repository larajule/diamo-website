---
---

<section class="features section" id="features">
  <div class="features-bg"></div>
  <div class="features-fade"></div>
  <div class="container">
    <div class="features-header">
      <span class="section-label animate-in" data-i18n="features.label">What you get</span>
      <h2 class="section-title animate-in" data-i18n="features.title">
        Three pillars.<br/>One philosophy.
      </h2>
    </div>
    
    <div class="features-grid">

      <div class="feature-card card animate-in" style="transition-delay: 0.1s">
        <div class="feature-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        </div>
        <h3 class="feature-title" data-i18n="features.f1.title">Body Intelligence</h3>
        <p class="feature-description" data-i18n="features.f1.desc">Your plan adapts to how you feel today — not your calendar. Bad sleep? Lower intensity. Full of energy? Time to push. No guilt, no rigid schedules. Just a system that listens.</p>
        <div class="feature-tags">
          <span class="feature-tag" data-i18n="features.f1.t1">Daily Check-in</span>
          <span class="feature-tag" data-i18n="features.f1.t2">Body Signals</span>
          <span class="feature-tag" data-i18n="features.f1.t3">Smart Rest Days</span>
        </div>
      </div>

      <div class="feature-card card animate-in" style="transition-delay: 0.2s">
        <div class="feature-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6"/><path d="M2.5 22v-6h6"/><path d="M21.12 8A9 9 0 0 0 4.5 5.7L2.5 8"/><path d="M2.88 16A9 9 0 0 0 19.5 18.3l2-2.3"/></svg>
        </div>
        <h3 class="feature-title" data-i18n="features.f2.title">Longevity Training</h3>
        <p class="feature-description" data-i18n="features.f2.desc">Strength, mobility, endurance, and recovery — the science-backed pillars for aging powerfully. 90 to 120 minutes of strength per week. That's the sweet spot research confirms.</p>
        <div class="feature-tags">
          <span class="feature-tag" data-i18n="features.f2.t1">Strength</span>
          <span class="feature-tag" data-i18n="features.f2.t2">Mobility</span>
          <span class="feature-tag" data-i18n="features.f2.t3">Endurance</span>
          <span class="feature-tag" data-i18n="features.f2.t4">Recovery</span>
        </div>
      </div>

      <div class="feature-card card animate-in" style="transition-delay: 0.3s">
        <div class="feature-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="feature-title" data-i18n="features.f3.title">Your Circle</h3>
        <p class="feature-description" data-i18n="features.f3.desc">Training alone lasts 3 months. Training together lasts a lifetime. Find women in your city for events, challenges, and real movement. No feed, no comparison. Just showing up together.</p>
        <div class="feature-tags">
          <span class="feature-tag" data-i18n="features.f3.t1">Local Events</span>
          <span class="feature-tag" data-i18n="features.f3.t2">Challenges</span>
          <span class="feature-tag" data-i18n="features.f3.t3">Real People</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    position: relative;
  }

  .features-bg {
    position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(165deg, 
      #edf1f6 0%, 
      #e8f0f8 20%, 
      #dde8f4 40%, 
      #d9e5f2 60%,
      #dfe9f4 80%,
      #edf1f6 100%);
  }

  .features-fade {
    position: absolute; bottom: 0; left: 0; right: 0; height: 200px;
    background: linear-gradient(to bottom, transparent 0%, var(--ivory) 100%);
    z-index: 1; pointer-events: none;
  }

  .features .container {
    position: relative; z-index: 2;
  }

  .features-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    align-items: stretch;
  }

  .feature-card {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border-top: 3px solid rgba(185, 215, 234, 0.6);
    box-shadow: 0 4px 24px rgba(0, 32, 96, 0.05), 0 1px 6px rgba(0, 0, 0, 0.03);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
    height: 100%;
  }

  .feature-card:hover {
    box-shadow: 0 8px 36px rgba(0, 32, 96, 0.1), 0 2px 12px rgba(155, 139, 203, 0.08);
    transform: translateY(-3px);
  }

  .feature-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(0, 32, 96, 0.05);
    color: var(--navy);
  }

  .feature-title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy);
  }

  .feature-highlight {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--navy);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    border-left: 3px solid currentColor;
  }

  .feature-description {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-secondary);
    flex-grow: 1;
  }

  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--space-xs);
  }

  .feature-tag {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--divider);
    color: var(--text-secondary);
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      padding: var(--space-md);
      height: auto;
    }

    .feature-description {
      font-size: 0.88rem;
      overflow-wrap: break-word;
    }

    .feature-highlight {
      font-size: 0.88rem;
    }
  }
</style>
