---
const milestones = [
  {
    date: 'Q2 2026',
    title: 'Focus: Beta',
    description: '100 test users validate the training logic with real data. Free test phase for product optimization.',
    users: '100 Testers',
    status: 'active'
  },
  {
    date: 'Q3 2026',
    title: 'App Store Launch',
    description: 'Launch in app stores. Leveraging existing communities (run clubs, studios) as multipliers for organic trust.',
    users: '3,000 Active Users',
    status: 'upcoming'
  },
  {
    date: 'Q4 2026',
    title: 'Growth and Scale',
    description: 'In app reward system for streaks, invitations, and sharing achievements. Branded challenges and B2B partnerships.',
    users: '5,000 Active Users',
    status: 'upcoming'
  },
  {
    date: '2027',
    title: 'Viral Growth',
    description: 'Natural growth loops through social interaction. Scaling via cooperations with companies targeting our audience.',
    users: '45,000 Active Users',
    status: 'future'
  },
  {
    date: '2028',
    title: 'European Expansion',
    description: 'Rollout to 5 European markets. Building the world\'s largest data driven community for hormone based fitness.',
    users: '150,000+ Active Users',
    status: 'future'
  }
];
---

<section class="roadmap section" id="roadmap">
  <div class="container">
    <div class="roadmap-header">
      <span class="section-label animate-in">Roadmap</span>
      <h2 class="section-title animate-in">
        Scaling through genuine<br/>connection
      </h2>
      <p class="section-subtitle animate-in">
        Growth powered by real community bonds, 
        not digital isolation.
      </p>
    </div>
    
    <div class="timeline">
      {milestones.map((milestone, i) => (
        <div class={`timeline-item ${milestone.status} animate-in`} style={`transition-delay: ${0.1 + i * 0.1}s`}>
          <div class="timeline-marker">
            <div class="timeline-dot"></div>
            {i < milestones.length - 1 && <div class="timeline-line"></div>}
          </div>
          <div class="timeline-content">
            <span class="timeline-date">{milestone.date}</span>
            <h3 class="timeline-title">{milestone.title}</h3>
            <p class="timeline-description">{milestone.description}</p>
            <div class="timeline-users">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
              </svg>
              {milestone.users}
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="roadmap-cta animate-in">
      <div class="cta-card">
        <div class="cta-content">
          <h3>Be part of the journey</h3>
          <p>Join our beta program and help shape the future of women's fitness.</p>
        </div>
        <a href="#beta" class="btn btn-primary" data-open-beta>Beta-Testerin werden</a>
      </div>
    </div>
  </div>
</section>

<style>
  .roadmap {
    background: linear-gradient(180deg, var(--ivory) 0%, var(--white) 100%);
  }

  .roadmap-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .roadmap-header .section-subtitle {
    margin: 0 auto;
  }

  .timeline {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: flex;
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 20px;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--divider);
    border: 3px solid var(--ivory);
    box-shadow: 0 0 0 2px var(--divider);
    flex-shrink: 0;
    transition: all var(--transition-base);
  }

  .active .timeline-dot {
    background: var(--navy);
    box-shadow: 0 0 0 2px var(--navy), 0 0 12px rgba(0, 32, 96, 0.3);
  }

  .upcoming .timeline-dot {
    background: var(--lavender);
    box-shadow: 0 0 0 2px var(--lavender);
  }

  .timeline-line {
    width: 2px;
    flex-grow: 1;
    background: linear-gradient(180deg, var(--divider) 0%, rgba(232, 232, 237, 0.3) 100%);
    margin-top: 4px;
  }

  .active .timeline-line {
    background: linear-gradient(180deg, var(--navy) 0%, var(--divider) 100%);
  }

  .timeline-content {
    padding-top: 0;
    padding-bottom: var(--space-sm);
  }

  .timeline-date {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--lavender);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .timeline-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
    margin: 0.3rem 0 0.5rem;
  }

  .timeline-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .timeline-users {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--navy);
    padding: 0.3rem 0.8rem;
    background: rgba(0, 32, 96, 0.04);
    border-radius: var(--radius-full);
  }

  .future .timeline-title,
  .future .timeline-description {
    opacity: 0.6;
  }

  /* CTA */
  .roadmap-cta {
    margin-top: var(--space-xl);
  }

  .cta-card {
    background: linear-gradient(135deg, var(--navy) 0%, #1a3a7a 100%);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .cta-content h3 {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 0.5rem;
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
  }

  .cta-card .btn-primary {
    background: var(--white);
    color: var(--navy);
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .cta-card .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 768px) {
    .cta-card {
      flex-direction: column;
      text-align: center;
      padding: var(--space-lg) var(--space-md);
    }

    .cta-content h3 {
      font-size: 1.2rem;
    }

    .timeline-content {
      overflow-wrap: break-word;
      min-width: 0;
    }

    .timeline-description {
      font-size: 0.85rem;
    }
  }
</style>
