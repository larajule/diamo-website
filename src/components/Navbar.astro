---
---

<nav class="navbar navbar--transparent" id="navbar">
  <div class="nav-container">
    <a href="/" class="nav-logo">d.</a>
    
    <div class="nav-links" id="nav-links">
      <a href="/#how-it-works" class="nav-link" data-i18n="nav.features">How it works</a>
      <a href="/#pillars" class="nav-link" data-i18n="nav.pillars">Pillars</a>
      <a href="/#team" class="nav-link" data-i18n="nav.team">Team</a>
      <a href="/ueber-uns" class="nav-link" data-i18n="nav.about">About</a>
      <div class="lang-toggle lang-desktop">
        <button class="lang-btn" data-lang="en">EN</button>
        <button class="lang-btn active" data-lang="de">DE</button>
      </div>
      <button type="button" class="btn btn-primary nav-cta" data-open-beta data-i18n="nav.cta">Early Access</button>
    </div>

    <!-- Mobile: lang toggle + hamburger -->
    <div class="nav-right-mobile">
      <div class="lang-toggle lang-mobile">
        <button class="lang-btn" data-lang="en">EN</button>
        <button class="lang-btn active" data-lang="de">DE</button>
      </div>
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0 var(--space-md);
    height: var(--nav-height);
    display: flex;
    align-items: center;
    transition: background var(--duration-base) var(--ease-smooth),
                border-color var(--duration-base),
                box-shadow var(--duration-base);
  }

  /* ─── Transparent state (on dark hero) ─── */
  .navbar--transparent {
    background: transparent;
    border-bottom: 1px solid transparent;
  }
  .navbar--transparent .nav-logo { color: var(--white); }
  .navbar--transparent .nav-link { color: rgba(255, 255, 255, 0.7); }
  .navbar--transparent .nav-link:hover { color: var(--white); }
  .navbar--transparent .nav-link::after { background: var(--white); }
  .navbar--transparent .nav-toggle span { background: var(--white); }
  .navbar--transparent .lang-btn { color: rgba(255, 255, 255, 0.5); }
  .navbar--transparent .lang-btn.active { background: rgba(255,255,255,0.15); color: var(--white); }
  .navbar--transparent .lang-toggle { background: rgba(255, 255, 255, 0.08); }

  /* ─── Scrolled state (solid) ─── */
  .navbar.scrolled {
    background: rgba(252, 251, 247, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom-color: var(--divider);
    box-shadow: var(--shadow-sm);
  }
  .navbar.scrolled .nav-logo { color: var(--navy); }
  .navbar.scrolled .nav-link { color: var(--text-secondary); }
  .navbar.scrolled .nav-link:hover { color: var(--navy); }
  .navbar.scrolled .nav-link::after { background: var(--navy); }
  .navbar.scrolled .nav-toggle span { background: var(--navy); }
  .navbar.scrolled .lang-btn { color: var(--text-muted); }
  .navbar.scrolled .lang-btn.active { background: var(--navy); color: var(--white); }
  .navbar.scrolled .lang-toggle { background: rgba(0, 32, 96, 0.04); }

  .nav-container {
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color var(--duration-base);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-link {
    font-size: 0.88rem;
    font-weight: 500;
    transition: color var(--duration-fast);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1.5px;
    border-radius: 1px;
    transition: width var(--duration-base);
  }

  .nav-link:hover::after { width: 100%; }
  .nav-link.active::after { width: 100%; }

  .nav-cta {
    padding: 0.6rem 1.4rem;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  /* Language Toggle */
  .lang-toggle {
    display: flex;
    align-items: center;
    border-radius: var(--radius-full);
    padding: 2px;
    gap: 0;
    transition: background var(--duration-base);
  }

  .lang-btn {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.55rem;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .lang-btn.active {
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }

  /* Mobile */
  .nav-right-mobile {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-mobile { display: none; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle span {
    width: 22px;
    height: 2px;
    border-radius: 2px;
    transition: all var(--duration-fast);
  }

  @media (max-width: 768px) {
    .nav-right-mobile { display: flex; }
    .lang-mobile { display: flex; }
    .lang-desktop { display: none; }
    .nav-toggle { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      flex-direction: column;
      background: rgba(252, 251, 247, 0.98);
      backdrop-filter: blur(20px);
      padding: var(--space-lg);
      gap: var(--space-md);
      border-bottom: 1px solid var(--divider);
    }

    .nav-links .nav-link { color: var(--text-secondary); }
    .nav-links .nav-link:hover { color: var(--navy); }

    .nav-links.open { display: flex; }
  }
</style>

<script>
  // Scroll: transparent → solid
  const navbar = document.getElementById('navbar');
  function updateNavbar() {
    if (window.scrollY > 80) {
      navbar?.classList.add('scrolled');
      navbar?.classList.remove('navbar--transparent');
    } else {
      navbar?.classList.remove('scrolled');
      navbar?.classList.add('navbar--transparent');
    }
  }
  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  // Mobile toggle
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    links?.classList.toggle('open');
  });

  // Active nav link
  function updateActiveNav() {
    const navLinks = document.querySelectorAll('.nav-link');
    const currentPath = window.location.pathname;
    navLinks.forEach(link => link.classList.remove('active'));

    const pageMatch = Array.from(navLinks).find(link => {
      const href = link.getAttribute('href');
      if (!href || href.startsWith('/#') || href === '/') return false;
      return currentPath.startsWith(href);
    });

    if (pageMatch) { pageMatch.classList.add('active'); return; }

    if (currentPath === '/' || currentPath === '/index.html') {
      const sections = ['how-it-works', 'pillars', 'team'];
      const scrollY = window.scrollY + window.innerHeight / 3;
      for (const id of sections) {
        const el = document.getElementById(id);
        if (el && scrollY >= el.offsetTop && scrollY < el.offsetTop + el.offsetHeight) {
          navLinks.forEach(link => {
            if (link.getAttribute('href') === `/#${id}`) link.classList.add('active');
          });
          break;
        }
      }
    }
  }
  updateActiveNav();
  window.addEventListener('scroll', updateActiveNav, { passive: true });

  // Language toggle
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      document.querySelectorAll('.lang-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-lang') === lang);
      });
      function trySetLang() {
        if (typeof window.setLanguage === 'function') {
          window.setLanguage(lang);
        } else {
          setTimeout(trySetLang, 100);
        }
      }
      trySetLang();
    });
  });

  // Sync on load
  const urlLang = new URLSearchParams(window.location.search).get('lang');
  const savedLang = urlLang || localStorage.getItem('diamo-lang') ||
                    (navigator.language?.slice(0, 2) === 'de' ? 'de' : 'en');
  document.querySelectorAll('.lang-btn').forEach(b => {
    b.classList.toggle('active', b.getAttribute('data-lang') === savedLang);
  });
</script>
