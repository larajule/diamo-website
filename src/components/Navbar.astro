---
---

<nav class="navbar" id="navbar">
  <div class="nav-container">
    <a href="/" class="nav-logo">d.</a>
    
    <div class="nav-links" id="nav-links">
      <a href="/#features" class="nav-link" data-i18n="nav.features">Features</a>
      <a href="/#how-it-works" class="nav-link" data-i18n="nav.how">So funktioniert's</a>
      <a href="/#team" class="nav-link" data-i18n="nav.team">Team</a>
      <a href="/ueber-uns" class="nav-link" data-i18n="nav.about">Über uns</a>
      <a href="/zyklusbasiertes-training" class="nav-link">Guide</a>
      <div class="lang-toggle">
        <button class="lang-btn" data-lang="en" onclick="setLanguage('en')">EN</button>
        <button class="lang-btn active" data-lang="de" onclick="setLanguage('de')">DE</button>
      </div>
      <a href="#beta" class="btn btn-primary nav-cta" data-open-beta data-i18n="nav.cta">Beta-Tester werden</a>
    </div>
    
    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0 var(--space-md);
    height: var(--nav-height);
    display: flex;
    align-items: center;
    background: rgba(252, 251, 247, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid transparent;
    transition: all var(--transition-base);
  }

  .navbar.scrolled {
    border-bottom-color: var(--divider);
    box-shadow: var(--shadow-sm);
  }

  .nav-container {
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--navy);
    border-radius: 1px;
    transition: width var(--transition-base);
  }

  .nav-link:hover {
    color: var(--navy);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-link.active {
    color: var(--navy);
  }

  .nav-link.active::after {
    width: 100%;
    background: var(--navy);
  }

  .nav-cta {
    padding: 0.65rem 1.5rem;
    font-size: 0.85rem;
  }

  /* Language Toggle */
  .lang-toggle {
    display: flex;
    align-items: center;
    background: rgba(0, 32, 96, 0.04);
    border-radius: var(--radius-full);
    padding: 2px;
    gap: 0;
  }

  .lang-btn {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.6rem;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lang-btn.active {
    background: var(--navy);
    color: var(--white);
    box-shadow: 0 1px 4px rgba(0, 32, 96, 0.2);
  }

  .lang-btn:hover:not(.active) {
    color: var(--navy);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle span {
    width: 22px;
    height: 2px;
    background: var(--navy);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      flex-direction: column;
      background: rgba(252, 251, 247, 0.98);
      backdrop-filter: blur(20px);
      padding: var(--space-lg);
      gap: var(--space-md);
      border-bottom: 1px solid var(--divider);
    }

    .nav-links.open {
      display: flex;
    }
  }
</style>

<script>
  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  });

  // Mobile toggle
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    links?.classList.toggle('open');
  });

  // Active nav link highlighting
  function updateActiveNav() {
    const navLinks = document.querySelectorAll('.nav-link');
    const currentPath = window.location.pathname;

    // Clear all active states
    navLinks.forEach(link => link.classList.remove('active'));

    // Check for standalone pages first (Über uns, Guide, etc.)
    const pageMatch = Array.from(navLinks).find(link => {
      const href = link.getAttribute('href');
      if (!href || href.startsWith('/#') || href === '/') return false;
      return currentPath.startsWith(href);
    });

    if (pageMatch) {
      pageMatch.classList.add('active');
      return;
    }

    // On the homepage, use scroll-based section detection
    if (currentPath === '/' || currentPath === '/index.html') {
      const sections = ['features', 'how-it-works', 'team'];
      const sectionElements = sections
        .map(id => ({ id, el: document.getElementById(id) }))
        .filter(s => s.el);

      if (sectionElements.length === 0) return;

      // Find which section is most visible
      let activeSection = null;
      const scrollY = window.scrollY + window.innerHeight / 3;

      for (const section of sectionElements) {
        const top = section.el.offsetTop;
        const bottom = top + section.el.offsetHeight;
        if (scrollY >= top && scrollY < bottom) {
          activeSection = section.id;
          break;
        }
      }

      if (activeSection) {
        navLinks.forEach(link => {
          const href = link.getAttribute('href');
          if (href === `/#${activeSection}`) {
            link.classList.add('active');
          }
        });
      }
    }
  }

  // Run on load and scroll
  updateActiveNav();
  window.addEventListener('scroll', updateActiveNav);

  // Also update when clicking nav links (for smooth scroll)
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      setTimeout(updateActiveNav, 100);
    });
  });
</script>
