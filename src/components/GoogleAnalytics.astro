---
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!-- Google Analytics (via Partytown) — Consent Mode v2 -->
{gaId && (
  <>
    <script type="text/partytown" async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script type="text/partytown" define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Default: deny analytics storage until user consents
      gtag('consent', 'default', {
        'analytics_storage': 'denied'
      });

      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
