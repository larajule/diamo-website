---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
import BetaApplyModals from '../components/BetaApplyModals.astro';
---

<Layout title="Über uns | diamo" description="Erfahre mehr über die Idee und Vision hinter diamo. Zyklusbasiertes Training, unterstützt durch Forschung, Community und echte Verbindungen.">
  <Navbar />
  <main class="about-page">
    <div class="about-container">
      
      <div class="about-hero">
        <h1 class="about-title">
          <span data-i18n="about.title">Dein Zyklus ist deine Superkraft.</span><br/>
          <span class="about-title-italic" data-i18n="about.title.italic">Wir helfen dir, sie zu nutzen.</span>
        </h1>
        <div class="about-divider"></div>
      </div>

      <section class="about-section">
        <h2 class="about-h2" data-i18n="about.story.title">Warum es diamo gibt</h2>
        <p data-i18n="about.story.p1">
          Viel zu lange hat Fitness den grundlegendsten Teil der weiblichen Biologie ignoriert: den Zyklus. Trainingspläne haben an Tag 5 und Tag 25 die gleiche Leistung erwartet. Sie haben Frauen das Gefühl gegeben zu versagen, wenn ihr Körper einfach etwas anderes brauchte.
        </p>
        <p data-i18n="about.story.p2">
          Aber die Wissenschaft ist eindeutig: Jede Frau durchläuft vier verschiedene Zyklusphasen, die ihre Energie, Kraft und Erholung auf einzigartige Weise beeinflussen. Das ist keine Einschränkung, sondern ein Vorteil, wenn man ihn zu nutzen weiß.
        </p>
        <p data-i18n="about.story.p3">
          Deshalb wurde diamo gebaut. Die App, die endlich mit deinem Zyklus trainiert, nicht gegen ihn.
        </p>
      </section>

      <section class="about-section about-vision">
        <h2 class="about-h2" data-i18n="about.vision.title">Training, das die Sprache deines Zyklus spricht</h2>
        <p data-i18n="about.vision.p1">
          In der Follikelphase ist dein Körper bereit, Grenzen zu verschieben. In der Lutealphase braucht er eine andere Art von Stärke. diamo kennt den Unterschied und passt dein Training entsprechend an.
        </p>
        <p data-i18n="about.vision.p2">
          Wir verbinden die Daten deiner Apple Watch, deines Oura Rings oder Garmin mit Echtzeit Zyklusbewusstsein, um einen Plan zu erstellen, der genau zu dir passt. Heute. Kein generischer Plan. Dein Plan.
        </p>
        <p data-i18n="about.vision.p3">
          Und weil wir glauben, dass die besten Workouts gemeinsam passieren, verbindet diamo dich mit Frauen in deiner Nähe, die in einer ähnlichen Zyklusphase sind. Lokale Run Clubs, geteilte Energie, echte Connections. <strong>Offline first</strong>.
        </p>
      </section>

      <section class="about-section">
        <h2 class="about-h2" data-i18n="about.values.title">Woran wir glauben</h2>
        <p class="about-values-intro" data-i18n="about.values.intro">
          diamo basiert auf einer einfachen Überzeugung: Frauen verdienen Fitness Tools, die ihren Körper wirklich verstehen. Das sind die Prinzipien, die alles leiten, was wir schaffen.
        </p>
        
        <div class="about-values-grid">
          <div class="about-value-card">
            <div class="about-value-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 class="about-value-name" data-i18n="about.value2.title">Community first</h3>
            <p class="about-value-desc" data-i18n="about.value2.desc">Die besten Workouts passieren gemeinsam. diamo verbindet dich mit lokalen Frauen in ähnlichen Zyklusphasen für echtes, offline Training.</p>
          </div>
          <div class="about-value-card">
            <div class="about-value-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <h3 class="about-value-name" data-i18n="about.value3.title">Für Frauen gebaut</h3>
            <p class="about-value-desc" data-i18n="about.value3.desc">Kein Nachgedanke. Keine rosa Version einer Männer App. diamo ist von Grund auf um den weiblichen Körper und die weibliche Erfahrung herum designed.</p>
          </div>
        </div>
      </section>

      <div class="about-cta">
        <h3 class="about-cta-title" data-i18n="about.cta.title">Klingt nach etwas, das du erleben willst?</h3>
        <p class="about-cta-text" data-i18n="about.cta.text">Wir sind noch ganz am Anfang und genau das macht es besonders. Sei von Anfang an dabei.</p>
        <button type="button" class="btn btn-primary about-cta-btn" data-open-waitlist data-i18n="about.cta.btn">
          Frühzugang sichern
        </button>
      </div>

    </div>
  </main>
  <Footer />
  <WaitlistModal />
  <BetaApplyModals />
</Layout>

<style>
  .about-page {
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-2xl);
    min-height: 100vh;
  }

  .about-container {
    max-width: 740px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  /* Hero */
  .about-hero {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .about-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.25;
    margin-bottom: var(--space-lg);
  }

  .about-title-italic {
    font-style: italic;
    font-weight: 400;
  }

  .about-divider {
    width: 48px;
    height: 1px;
    background: var(--navy);
    opacity: 0.25;
    margin: 0 auto;
  }

  /* Sections */
  .about-section {
    margin-bottom: var(--space-2xl);
  }

  .about-h2 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: var(--space-md);
  }

  .about-section p {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  .about-section p:last-of-type {
    margin-bottom: 0;
  }

  /* Vision (dark) */
  .about-vision {
    background: var(--navy);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    margin: var(--space-xl) 0;
  }

  .about-vision .about-h2 {
    color: var(--ivory);
  }

  .about-vision p {
    color: rgba(251, 249, 246, 0.85);
  }

  .about-vision strong {
    color: var(--ivory);
  }

  /* Values Grid */
  .about-values-intro {
    margin-bottom: var(--space-xl) !important;
  }

  .about-values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .about-value-card {
    padding: var(--space-lg);
    border: 1px solid rgba(11, 25, 46, 0.08);
    border-radius: var(--radius-md);
    text-align: center;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .about-value-card:hover {
    border-color: rgba(11, 25, 46, 0.16);
    box-shadow: 0 4px 20px rgba(11, 25, 46, 0.04);
    transform: translateY(-2px);
  }

  .about-value-icon {
    width: 56px;
    height: 56px;
    background: rgba(155, 139, 203, 0.08);
    border-radius: var(--radius-md);
    margin: 0 auto var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lavender);
  }

  .about-value-name {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.4rem;
  }

  .about-value-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* CTA */
  .about-cta {
    text-align: center;
    padding-top: var(--space-xl);
    border-top: 1px solid rgba(11, 25, 46, 0.08);
  }

  .about-cta-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .about-cta-text {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .about-cta-btn {
    padding: 0.75rem 2rem;
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .about-values-grid {
      grid-template-columns: 1fr;
      max-width: 320px;
      margin: 0 auto;
    }

    .about-vision {
      padding: var(--space-lg);
    }
  }
</style>

