---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About Us | Diamo" description="Meet Marie and Lara — the founders of Diamo. Learn why we're building a fitness app that understands the female cycle.">
  <Navbar />
  <main class="about-page">
    <div class="about-container">
      
      <div class="about-hero">
        <h1 class="about-title">
          <span data-i18n="about.title">We believe fitness should</span><br/>
          <span class="about-title-italic" data-i18n="about.title.italic">work with your body, not against it.</span>
        </h1>
        <div class="about-divider"></div>
      </div>

      <section class="about-section">
        <h2 class="about-h2" data-i18n="about.story.title">Hi, we're Marie and Lara</h2>
        <p data-i18n="about.story.p1">
          We're two women who got tired of following training plans that weren't made for us. Plans that don't understand why some days we're full of energy and other days we just can't perform at the same level.
        </p>
        <p data-i18n="about.story.p2">
          At some point we realized: it's not a lack of discipline. It's our body working in its own rhythm. A cycle that individually varies between 21 and 35 days, naturally influencing our energy, strength, and recovery.
        </p>
        <p data-i18n="about.story.p3">
          So we decided to build something that understands this rhythm. That's how Diamo was born.
        </p>
      </section>

      <section class="about-section about-vision">
        <h2 class="about-h2" data-i18n="about.vision.title">What makes Diamo different</h2>
        <p data-i18n="about.vision.p1">
          Diamo isn't just another fitness app telling you to push harder. Diamo understands that your body doesn't work the same every day — and that's a good thing.
        </p>
        <p data-i18n="about.vision.p2">
          We connect data from your smartwatch or Oura Ring with knowledge about your cycle to create a training plan that truly fits you. Not yesterday, not tomorrow, but today.
        </p>
        <p data-i18n="about.vision.p3">
          And because we believe real motivation comes from real people, Diamo connects you with women near you. Local run clubs, shared workouts, real connections — <strong>offline first</strong>.
        </p>
      </section>

      <section class="about-section">
        <h2 class="about-h2" data-i18n="about.team.title">The people behind Diamo</h2>
        <p class="about-who-intro" data-i18n="about.team.intro">
          No big corporation, no anonymous team. Just two friends with a shared vision and the drive to change something.
        </p>
        
        <div class="about-team-grid">
          <div class="about-team-card">
            <div class="about-avatar">
              <img src="/team/marie.png" alt="Marie Westermann" />
            </div>
            <p class="about-name">Marie</p>
            <p class="about-role">Co-Founder</p>
            <p class="about-bio" data-i18n="about.marie.bio">Strategy, Operations & licensed fitness trainer. Brings consulting experience and a passion for community building.</p>
          </div>
          <div class="about-team-card">
            <div class="about-avatar">
              <img src="/team/lara.png" alt="Lara Bullemer" />
            </div>
            <p class="about-name">Lara</p>
            <p class="about-role">Co-Founder</p>
            <p class="about-bio" data-i18n="about.lara.bio">Creative Direction, Brand Strategy & Women's Health. Makes sure Diamo feels exactly the way it should.</p>
          </div>
        </div>
      </section>

      <div class="about-cta">
        <h3 class="about-cta-title" data-i18n="about.cta.title">Sound like something you want to be part of?</h3>
        <p class="about-cta-text" data-i18n="about.cta.text">We're just getting started — and that's what makes it special. Be there from the beginning.</p>
        <a href="/" class="btn btn-primary about-cta-btn" data-i18n="about.cta.btn">
          Join the Waitlist
        </a>
      </div>

    </div>
  </main>
  <Footer />
</Layout>

<style>
  .about-page {
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-2xl);
    min-height: 100vh;
  }

  .about-container {
    max-width: 740px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  /* Hero */
  .about-hero {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .about-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.25;
    margin-bottom: var(--space-lg);
  }

  .about-title-italic {
    font-style: italic;
    font-weight: 400;
  }

  .about-divider {
    width: 48px;
    height: 1px;
    background: var(--navy);
    opacity: 0.25;
    margin: 0 auto;
  }

  /* Sections */
  .about-section {
    margin-bottom: var(--space-2xl);
  }

  .about-h2 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: var(--space-md);
  }

  .about-section p {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  .about-section p:last-of-type {
    margin-bottom: 0;
  }

  /* Vision (dark) */
  .about-vision {
    background: var(--navy);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    margin: var(--space-xl) 0;
  }

  .about-vision .about-h2 {
    color: var(--ivory);
  }

  .about-vision p {
    color: rgba(251, 249, 246, 0.85);
  }

  .about-vision strong {
    color: var(--ivory);
  }

  /* Team Grid */
  .about-who-intro {
    margin-bottom: var(--space-xl) !important;
  }

  .about-team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .about-team-card {
    padding: var(--space-lg);
    border: 1px solid rgba(11, 25, 46, 0.08);
    border-radius: var(--radius-md);
    text-align: center;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .about-team-card:hover {
    border-color: rgba(11, 25, 46, 0.16);
    box-shadow: 0 4px 20px rgba(11, 25, 46, 0.04);
  }

  .about-avatar {
    width: 72px;
    height: 72px;
    background: rgba(11, 25, 46, 0.06);
    border-radius: 50%;
    margin: 0 auto var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .about-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-letter {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
    align-items: center;
    justify-content: center;
  }

  .about-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
  }

  .about-role {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
    margin-bottom: 0.6rem;
  }

  .about-bio {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* CTA */
  .about-cta {
    text-align: center;
    padding-top: var(--space-xl);
    border-top: 1px solid rgba(11, 25, 46, 0.08);
  }

  .about-cta-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .about-cta-text {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .about-cta-btn {
    padding: 0.75rem 2rem;
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .about-team-grid {
      grid-template-columns: 1fr;
      max-width: 320px;
      margin: 0 auto;
    }

    .about-vision {
      padding: var(--space-lg);
    }
  }
</style>
