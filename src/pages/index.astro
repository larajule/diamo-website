---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AnnouncementTicker from '../components/AnnouncementTicker.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import AppTeaser from '../components/AppTeaser.astro';
import KnowYourBody from '../components/KnowYourBody.astro';
import WalkingClub from '../components/WalkingClub.astro';
import Founders from '../components/Founders.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
import BetaApplyModals from '../components/BetaApplyModals.astro';
import EarlyAccessPopup from '../components/EarlyAccessPopup.astro';
---

<style>
/* Editorial pause — white breathing space between Hero and Manifesto */
.editorial-pause {
  background: var(--ivory, #FCFBF7);
  padding: 7rem 2rem 8rem;
  text-align: center;
  position: relative;
}
.pause-statement {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 3.5vw, 2.6rem);
  font-weight: 400;
  font-style: italic;
  color: var(--navy, #0C2A6E);
  letter-spacing: -0.02em;
  line-height: 1.25;
  margin: 0 auto;
  max-width: 620px;
  opacity: 0.75;
}
@media (max-width: 768px) {
  .editorial-pause { padding: 5rem 1.5rem 6rem; }
}
</style>

<Layout>
  <AnnouncementTicker />
  <Navbar />
  <main>
    <Hero />
    <div class="editorial-pause">
      <p class="pause-statement" data-i18n="pause.statement">THE LONG GAME STARTS HERE.</p>
    </div>
    <Manifesto />
    <AppTeaser />
    <KnowYourBody />
    <WalkingClub />
    <Founders />
    <EarlyAccess />
    <FAQ />
  </main>
  <Footer />
  <WaitlistModal />
  <BetaApplyModals />
  <EarlyAccessPopup />
</Layout>
