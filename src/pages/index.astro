---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Tension from '../components/Tension.astro';
import Solution from '../components/Solution.astro';
import Pillars from '../components/Pillars.astro';
import Founders from '../components/Founders.astro';
import CallToAction from '../components/CallToAction.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
import BetaApplyModals from '../components/BetaApplyModals.astro';
---

<Layout
  title="diamo — Find your movement. Find your people."
  description="Personalized fitness for women. Training that adapts to your body, your energy, and your life — with a community that shows up in real life."
>
  <Navbar />
  <main>
    <Hero />
    <Tension />
    <Solution />
    <Pillars />
    <Founders />
    <CallToAction />
    <FAQ />
  </main>
  <Footer />
  <WaitlistModal />
  <BetaApplyModals />
</Layout>
